@{
    ViewData["Title"] = "Departmanlar";
    ViewData["Subtitle"] = "Departman listenizi görüntüleyin ve yönetin.";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <style>
        .table-action-icon {
            border: 0;
            background: transparent;
            padding: 0.15rem 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

            .table-action-icon i {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .table-action-icon + .table-action-icon {
                margin-left: 0.4rem;
            }

            .table-action-icon.text-warning:hover i,
            .table-action-icon.text-danger:hover i {
                opacity: 0.8;
            }

        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        body.no-permission #btnAdd {
            pointer-events: none;
            opacity: .55;
        }

        body.no-permission .table-action-icon {
            pointer-events: none;
            opacity: .35;
            cursor: not-allowed;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>Departmanlar</h3>
                <p class="text-subtitle text-muted">Departman listenizi görüntüleyin ve yönetin.</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Departmanlar</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="small text-muted">@ViewData["Subtitle"]</div>
        </div>

        <button id="btnAdd"
                type="button"
                class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Yeni Departman</span>
        </button>
    </div>
    <div class="card-body">
        <table id="departmentsTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th style="width:140px;">Kod</th>
                    <th>Departman Adı</th>
                    <th class="text-end" style="width:140px;">İşlemler</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="departmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Departman</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="DepartmentId" />

                <div class="mb-3">
                    <label for="DepartmentCode" class="form-label">Departman Kodu</label>
                    <input type="text"
                           id="DepartmentCode"
                           class="form-control"
                           placeholder="Örn: HR01" />
                    <div id="DepartmentCodeError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">Departman kodunu benzersiz olacak şekilde giriniz.</div>
                </div>

                <div class="mb-3">
                    <label for="DepartmentName" class="form-label">Departman Adı</label>
                    <input type="text"
                           id="DepartmentName"
                           class="form-control"
                           placeholder="Örn: İnsan Kaynakları" />
                    <div id="DepartmentNameError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">Departman adını eksiksiz ve anlaşılır yazınız.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="btnSave">
                    <i class="bi bi-save me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteDepartmentModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Silme Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    Bu departmanı silmek istediğinize emin misiniz?
                </p>
                <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                <input type="hidden" id="DeleteDepartmentId" />
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteConfirm">
                    <i class="bi bi-trash me-1"></i>Sil
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');

                switch ((variant || 'danger').toLowerCase()) {
                    case 'success':
                        toastEl.classList.add('bg-success', 'text-white');
                        break;
                    case 'warning':
                        toastEl.classList.add('bg-warning', 'text-dark');
                        break;
                    case 'info':
                        toastEl.classList.add('bg-info', 'text-dark');
                        break;
                    case 'secondary':
                        toastEl.classList.add('bg-secondary', 'text-white');
                        break;
                    default:
                        toastEl.classList.add('bg-danger', 'text-white');
                        break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) {
                    alert(message || '');
                    return;
                }

                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');

                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });

                toast.show();
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;

                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');

                $('#btnAdd').prop('disabled', true).addClass('disabled');
                $('body').addClass('no-permission');

                $('#departmentsTable').find('.btn-edit,.btn-delete')
                    .prop('disabled', true).addClass('disabled');
            }

            var table = $('#departmentsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetList", "Departments")',
                    type: 'GET',
                    dataSrc: 'data',
                    error: function () {
                        setNoPermission('yetkiniz bulunmamaktadır.');
                    }
                },
                columns: [
                    {
                        data: null,
                        title: '#',
                        width: '70px',
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    {
                        data: 'code',
                        title: 'Kod',
                        width: '140px'
                    },
                    {
                        data: 'name',
                        title: 'Departman Adı'
                    },
                    {
                        data: null,
                        title: 'İşlemler',
                        orderable: false,
                        searchable: false,
                        width: '140px',
                        className: 'text-end',
                        render: function (data, type, row) {
                            return `
                                <button class="table-action-icon text-warning btn-edit" data-id="${row.id}" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="table-action-icon text-danger btn-delete" data-id="${row.id}" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>`;
                        }
                    }
                ],
                paging: true,
                searching: true,
                info: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: {
                    url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json"
                },
                drawCallback: function () {
                    if (!noPermission) return;
                    $('#btnAdd').prop('disabled', true).addClass('disabled');
                    $('body').addClass('no-permission');
                    $('#departmentsTable').find('.btn-edit,.btn-delete')
                        .prop('disabled', true).addClass('disabled');
                }
            });

            function clearValidation() {
                $('#DepartmentCode').removeClass('is-invalid');
                $('#DepartmentName').removeClass('is-invalid');
                $('#DepartmentCodeError').removeClass('active').text('');
                $('#DepartmentNameError').removeClass('active').text('');
            }

            function showCodeRequiredError() {
                $('#DepartmentCode').addClass('is-invalid');
                $('#DepartmentCodeError')
                    .addClass('active')
                    .text('Departman kodu zorunludur.');
            }

            function showNameRequiredError() {
                $('#DepartmentName').addClass('is-invalid');
                $('#DepartmentNameError')
                    .addClass('active')
                    .text('Departman adı zorunludur.');
            }

            function openCreateModal() {
                $('#DepartmentId').val('');
                $('#DepartmentCode').val('');
                $('#DepartmentName').val('');
                clearValidation();
                $('#modalTitle').text('Yeni Departman');
                var modal = new bootstrap.Modal(document.getElementById('departmentModal'));
                modal.show();
            }

            function openEditModal(id) {
                clearValidation();
                $.get('@Url.Action("Get", "Departments")', { id: id })
                    .done(function (res) {
                        $('#DepartmentId').val(res.id);
                        $('#DepartmentCode').val(res.code);
                        $('#DepartmentName').val(res.name);
                        $('#modalTitle').text('Departman Düzenle');
                        var modal = new bootstrap.Modal(document.getElementById('departmentModal'));
                        modal.show();
                    })
                    .fail(function () {
                        showPopup('Kayıt okunamadı.', 'danger');
                    });
            }

            $('#btnAdd').on('click', function () {
                if (noPermission) return;
                openCreateModal();
            });

            $('#departmentsTable').on('click', '.btn-edit', function () {
                if (noPermission) return;
                var id = $(this).data('id');
                openEditModal(id);
            });

            var deleteModalEl = document.getElementById('deleteDepartmentModal');
            var deleteModal = new bootstrap.Modal(deleteModalEl);

            $('#departmentsTable').on('click', '.btn-delete', function () {
                if (noPermission) return;
                var id = $(this).data('id');
                $('#DeleteDepartmentId').val(id);
                deleteModal.show();
            });

            $('#btnDeleteConfirm').on('click', function () {
                if (noPermission) return;

                var id = $('#DeleteDepartmentId').val();
                if (!id) return;

                $.ajax({
                    url: '@Url.Action("Delete", "Departments")',
                    type: 'POST',
                    data: { id: id }
                })
                    .done(function (res) {
                        if (res.success) {
                            deleteModal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Silme işlemi tamamlandı.', 'success');
                        } else {
                            showPopup(res.message || 'Silme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function () {
                        showPopup('Silme işlemi sırasında hata oluştu.', 'danger');
                    });
            });

            $('#btnSave').on('click', function () {
                if (noPermission) return;

                clearValidation();

                var id = $('#DepartmentId').val();
                var code = $('#DepartmentCode').val().trim();
                var name = $('#DepartmentName').val().trim();

                var hasError = false;

                if (!code) {
                    showCodeRequiredError();
                    hasError = true;
                }

                if (!name) {
                    showNameRequiredError();
                    hasError = true;
                }

                if (hasError) return;

                var isNew = !id;

                var url = isNew
                    ? '@Url.Action("Create", "Departments")'
                    : '@Url.Action("Update", "Departments")';

                var payload = isNew
                    ? { Code: code, Name: name }
                    : { Id: parseInt(id), Code: code, Name: name };

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: payload
                })
                    .done(function (res) {
                        if (res.success) {
                            var modalEl = document.getElementById('departmentModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            modal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Kayıt başarıyla kaydedildi.', 'success');
                        } else {
                            showPopup(res.message || 'Kaydetme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function () {
                        showPopup('Kaydetme işlemi sırasında hata oluştu.', 'danger');
                    });
            });
        });
    </script>
}
