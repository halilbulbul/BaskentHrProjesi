@{
    ViewData["Title"] = "İzin Taleplerim";
    ViewData["Subtitle"] = "Kendi izin taleplerinizi görüntüleyin ve yeni izin talebi oluşturun.";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        .table-action-icon {
            border: 0;
            background: transparent;
            padding: 0.15rem 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

            .table-action-icon i {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .table-action-icon + .table-action-icon {
                margin-left: 0.4rem;
            }

            .table-action-icon.text-warning:hover i,
            .table-action-icon.text-danger:hover i {
                opacity: 0.8;
            }

        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        body.no-permission #btnAdd {
            pointer-events: none;
            opacity: .55;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>İzin Taleplerim</h3>
                <p class="text-subtitle text-muted">@ViewData["Subtitle"]</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">İzin Taleplerim</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="small text-muted">@ViewData["Subtitle"]</div>
        </div>
        <button id="btnAdd" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Yeni İzin Talebi</span>
        </button>
    </div>
    <div class="card-body">
        <table id="employeeLeavesTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th style="width:180px;">İzin Türü</th>
                    <th style="width:140px;">Başlangıç</th>
                    <th style="width:140px;">Bitiş</th>
                    <th style="width:80px;">Gün</th>
                    <th style="width:140px;">Durum</th>
                    <th style="width:140px;">Talep Tarihi</th>
                    <th style="width:180px;">Onaylayan</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="employeeLeaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="employeeLeaveModalLabel">Yeni İzin Talebi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="EmployeeLeaveId" />

                <div class="row g-3">
                    <div class="col-12">
                        <div class="alert alert-info py-2 mb-2">
                            Bu ekrandan <strong>kendi adınıza</strong> izin talebi oluşturabilirsiniz. Yöneticinize Onaya Düşecektir.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label for="LeaveTypeId" class="form-label">İzin Türü</label>
                        <select id="LeaveTypeId" class="form-select">
                            <option value="">İzin türü seçin</option>
                        </select>
                        <div id="LeaveTypeIdError" class="field-error text-danger small mt-1"></div>
                        <div class="form-text">Kullanmak istediğiniz izin türünü seçiniz.</div>
                    </div>

                    <div class="col-md-6">
                        <label for="TotalDays" class="form-label">Toplam Gün</label>
                        <input type="number" id="TotalDays" class="form-control" min="0" readonly />
                    </div>

                    <div class="col-md-6">
                        <label for="StartDate" class="form-label">Başlangıç Tarihi</label>
                        <input type="date" id="StartDate" class="form-control" />
                        <div id="StartDateError" class="field-error text-danger small mt-1"></div>
                        <div class="form-text">İznin başlangıç tarihini giriniz.</div>
                    </div>

                    <div class="col-md-6">
                        <label for="EndDate" class="form-label">Bitiş Tarihi</label>
                        <input type="date" id="EndDate" class="form-control" />
                        <div id="EndDateError" class="field-error text-danger small mt-1"></div>
                        <div class="form-text">İznin bitiş tarihini giriniz.</div>
                    </div>

                    <div class="col-12">
                        <div class="small text-muted">
                            Talep kaydedildiğinde durum <strong>Beklemede</strong> olarak oluşturulacak ve
                            talep tarihi sistem tarafından atanacaktır.
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="btnSave">
                    <i class="bi bi-save me-1"></i>Talebi Gönder
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteEmployeeLeaveModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Silme Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Bu izin kaydını silmek istediğinize emin misiniz?</p>
                <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                <input type="hidden" id="DeleteEmployeeLeaveId" />
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnConfirmDelete">
                    <i class="bi bi-trash me-1"></i>Sil
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');

                switch ((variant || 'danger').toLowerCase()) {
                    case 'success':
                        toastEl.classList.add('bg-success', 'text-white');
                        break;
                    case 'warning':
                        toastEl.classList.add('bg-warning', 'text-dark');
                        break;
                    case 'info':
                        toastEl.classList.add('bg-info', 'text-dark');
                        break;
                    case 'secondary':
                        toastEl.classList.add('bg-secondary', 'text-white');
                        break;
                    default:
                        toastEl.classList.add('bg-danger', 'text-white');
                        break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) {
                    alert(message || '');
                    return;
                }

                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');

                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });

                toast.show();
            }

            function isNoPermission(xhr) {
                var s = (xhr && typeof xhr.status !== 'undefined') ? xhr.status : 0;
                return s === 401 || s === 403 || s === 0 || s >= 500;
            }

            function applyNoPermissionUi() {
                $('#btnAdd').prop('disabled', true).addClass('disabled');
                $('body').addClass('no-permission');
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;
                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');
                applyNoPermissionUi();
            }

            function handleFail(xhr, msg) {
                if (isNoPermission(xhr)) {
                    setNoPermission(msg || 'yetkiniz bulunmamaktadır.');
                } else {
                    showPopup(msg || 'İşlem sırasında hata oluştu.', 'danger');
                }
            }

            var table = $('#employeeLeavesTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetMyList", "EmployeeLeaves")',
                    type: 'GET',
                    dataSrc: 'data',
                    error: function (xhr) {
                        handleFail(xhr, 'yetkiniz bulunmamaktadır.');
                    }
                },
                columns: [
                    {
                        data: null,
                        width: '70px',
                        className: 'text-center',
                        render: function (d, t, r, m) {
                            return m.row + 1;
                        }
                    },
                    { data: 'leaveTypeName', width: '180px' },
                    {
                        data: 'startDate',
                        width: '140px',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('tr-TR') : '';
                        }
                    },
                    {
                        data: 'endDate',
                        width: '140px',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('tr-TR') : '';
                        }
                    },
                    { data: 'totalDays', width: '80px' },
                    { data: 'approvalStatus', width: '140px' },
                    {
                        data: 'requestDate',
                        width: '140px',
                        render: function (data) {
                            return data ? new Date(data).toLocaleDateString('tr-TR') : '';
                        }
                    },
                    { data: 'approverFullName', width: '180px' }
                ],
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                drawCallback: function () {
                    if (!noPermission) return;
                    applyNoPermissionUi();
                }
            });

            function clearValidation() {
                $('#LeaveTypeId,#StartDate,#EndDate').removeClass('is-invalid');
                $('#LeaveTypeIdError,#StartDateError,#EndDateError').removeClass('active').text('');
            }

            function showError(id, msg) {
                $(id).addClass('is-invalid');
                $(id + 'Error').addClass('active').text(msg);
            }

            function fillSelect($el, data, selectedId, textSelector) {
                $el.empty();
                $el.append($('<option>', { value: '', text: 'Seçin' }));
                $.each(data || [], function (_, item) {
                    $el.append($('<option>', {
                        value: item.id,
                        text: textSelector(item)
                    }));
                });
                if (selectedId) $el.val(String(selectedId));
            }

            function loadLeaveTypes(selectedId) {
                return $.get('@Url.Action("GetList", "LeaveTypes")')
                    .done(function (res) {
                        fillSelect($('#LeaveTypeId'), res.data, selectedId, function (x) {
                            return (x.code || '') + ' - ' + (x.name || '');
                        });
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'yetkiniz bulunmamaktadır.');
                    });
            }

            function updateTotalDays() {
                var startDate = $('#StartDate').val();
                var endDate = $('#EndDate').val();

                if (!startDate || !endDate) {
                    $('#TotalDays').val('');
                    return;
                }

                var start = new Date(startDate + 'T00:00:00');
                var end = new Date(endDate + 'T00:00:00');

                if (isNaN(start) || isNaN(end) || end < start) {
                    $('#TotalDays').val('');
                    return;
                }

                var diffMs = end - start;
                var diffDays = diffMs / (1000 * 60 * 60 * 24) + 1;
                $('#TotalDays').val(diffDays);
            }

            function openCreateModal() {
                $('#EmployeeLeaveId').val('');
                $('#LeaveTypeId').val('');
                $('#StartDate').val('');
                $('#EndDate').val('');
                $('#TotalDays').val('');
                clearValidation();
                $('#employeeLeaveModalLabel').text('Yeni İzin Talebi');

                $.when(loadLeaveTypes()).done(function () {
                    if (noPermission) return;
                    var modal = new bootstrap.Modal(document.getElementById('employeeLeaveModal'));
                    modal.show();
                });
            }

            $('#StartDate,#EndDate').on('change', updateTotalDays);

            $('#btnAdd').on('click', function () {
                if (noPermission) return;
                openCreateModal();
            });

            $('#btnSave').on('click', function () {
                if (noPermission) return;

                clearValidation();

                var leaveTypeId = $('#LeaveTypeId').val();
                var startDate = $('#StartDate').val();
                var endDate = $('#EndDate').val();
                var totalDays = $('#TotalDays').val();
                var hasError = false;

                if (!leaveTypeId) { showError('#LeaveTypeId', 'İzin türü zorunludur.'); hasError = true; }
                if (!startDate) { showError('#StartDate', 'Başlangıç tarihi zorunludur.'); hasError = true; }
                if (!endDate) { showError('#EndDate', 'Bitiş tarihi zorunludur.'); hasError = true; }
                if (hasError) return;

                var url = '@Url.Action("EmployeeLeaveRequest", "EmployeeLeaves")';

                var payload = {
                    leaveTypeId: leaveTypeId,
                    startDate: startDate,
                    endDate: endDate,
                    totalDays: totalDays || 0
                };

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: payload
                }).done(function (res) {
                    if (res && res.success) {
                        var modalEl = document.getElementById('employeeLeaveModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();
                        table.ajax.reload(null, false);
                        showPopup('İzin talebi oluşturuldu.', 'success');
                    } else {
                        showPopup((res && res.message) || 'İzin talebi oluşturulamadı.', 'warning');
                    }
                }).fail(function (xhr) {
                    handleFail(xhr, 'İzin talebi gönderilirken bir hata oluştu.');
                });
            });
        });
    </script>
}
