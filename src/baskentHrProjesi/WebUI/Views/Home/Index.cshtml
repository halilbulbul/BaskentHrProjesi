@{
    ViewData["Title"] = "Anasayfa";
    ViewData["Subtitle"] = "İnsan Kaynakları yönetim paneli özeti";
}

@section Styles {
    <link rel="stylesheet" href="~/vendors/iconly/bold.css" />

    <style>
        /* Departman trend grafiği */
        .trend-chart {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            height: 260px;
        }

        .trend-day {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            margin: 0 6px;
        }

        .trend-group {
            display: flex;
            align-items: flex-end;
            gap: 10px;
            height: 200px;
        }

        .trend-col {
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .trend-bar {
            width: 26px;
            border-radius: 4px;
        }

        /* İSTENEN RENKLER */
        .trend-present {
            background-color: #198754;
        }
        /* Mevcut = Yeşil */
        .trend-leave {
            background-color: #0d6efd;
        }
        /* İzinli = Mavi */
        .trend-absent {
            background-color: #dc3545;
        }
        /* Devamsız = Kırmızı */
        .trend-late {
            background-color: #ffc107;
        }
        /* Geç Gelen = Sarı */

        .trend-value {
            margin-top: 3px;
            font-size: .7rem;
            color: #6c757d;
            white-space: nowrap;
        }

        .trend-label {
            margin-top: 6px;
            font-size: .75rem;
            color: #6c757d;
            text-align: center;
        }

        .trend-legend {
            margin-top: 12px;
            font-size: .8rem;
            color: #6c757d;
        }

            .trend-legend span {
                margin-right: 16px;
            }

            .trend-legend i {
                display: inline-block;
                width: 10px;
                height: 10px;
                border-radius: 2px;
                margin-right: 4px;
                vertical-align: middle;
            }

            .trend-legend .lg-present i {
                background-color: #198754;
            }

            .trend-legend .lg-absent i {
                background-color: #dc3545;
            }

            .trend-legend .lg-leave i {
                background-color: #0d6efd;
            }

            .trend-legend .lg-late i {
                background-color: #ffc107;
            }

        /* BUGÜN DURUM KARTI */
        #card-today-status {
            border-radius: 18px;
            box-shadow: 0 8px 20px rgba(15,23,42,.08);
        }

            #card-today-status .card-header {
                border-bottom: 0;
                padding-bottom: .35rem;
            }

            #card-today-status h4 {
                font-size: 1rem;
                font-weight: 700;
            }

        .today-status-section {
            padding: .75rem 0;
            border-bottom: 1px dashed #e9ecef;
        }

            .today-status-section:last-child {
                border-bottom: 0;
            }

        .today-status-title {
            font-size: .9rem;
            font-weight: 600;
            color: #495057;
        }

        .today-status-count {
            min-width: 38px;
            border-radius: 999px;
            font-size: .8rem;
            font-weight: 600;
            text-align: center;
            padding: .15rem .55rem;
        }

        .today-status-list {
            max-height: 190px;
            overflow-y: auto;
            margin-top: .35rem;
        }

            .today-status-list::-webkit-scrollbar {
                width: 4px;
            }

            .today-status-list::-webkit-scrollbar-thumb {
                background-color: #ced4da;
                border-radius: 999px;
            }

        .today-status-item {
            display: flex;
            align-items: center;
            gap: .4rem;
            padding: .1rem 0;
            font-size: .85rem;
        }

            .today-status-item span {
                white-space: nowrap;
                text-overflow: ellipsis;
                overflow: hidden;
            }

        .today-status-dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            flex-shrink: 0;
        }

            /* İSTENEN RENKLER */
            .today-status-dot.present {
                background-color: #198754;
            }
            /* Mevcut */
            .today-status-dot.absent {
                background-color: #dc3545;
            }
            /* Devamsız */
            .today-status-dot.leave {
                background-color: #0d6efd;
            }
            /* İzinli */
            .today-status-dot.late {
                background-color: #ffc107;
            }
        /* Geç Gelen (ileride liste eklenirse) */

        .today-status-empty {
            font-size: .8rem;
            color: #adb5bd;
        }

        .today-status-section:hover .today-status-title {
            color: #0d6efd;
            transition: color .15s ease-in-out;
        }

        /* ===== Dashboard Bölüm Ayırıcı ===== */
        .dashboard-section {
            border: 1px solid rgba(15,23,42,.06);
            border-radius: 18px;
            background: #fff;
            box-shadow: 0 8px 20px rgba(15,23,42,.06);
            padding: 16px 16px 6px 16px;
            margin-bottom: 14px;
            position: relative;
            overflow: hidden;
        }

            .dashboard-section.company {
                border-left: 6px solid #6f42c1;
                background: linear-gradient(180deg, rgba(111,66,193,.06), rgba(255,255,255,0) 45%), #fff;
            }

            .dashboard-section.mine {
                border-left: 6px solid #0d6efd;
                background: linear-gradient(180deg, rgba(13,110,253,.06), rgba(255,255,255,0) 45%), #fff;
            }

        .section-block {
            border: 1px dashed rgba(15,23,42,.14);
            border-radius: 16px;
            padding: 14px 14px 6px 14px;
            margin-bottom: 14px;
            background: rgba(15,23,42,.015);
        }

            .section-block.block-summary {
                background: rgba(15,23,42,.015);
            }

            .section-block.block-chart {
                background: rgba(15,23,42,.01);
            }

            .section-block.block-monthly {
                background: rgba(15,23,42,.012);
            }

            .section-block.block-table {
                background: rgba(15,23,42,.01);
            }

        .section-block-title {
            font-size: .75rem;
            font-weight: 800;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: .06em;
            margin: 0 0 10px 2px;
        }

        .dashboard-section-title {
            display: flex;
            align-items: center;
            gap: .6rem;
            margin-bottom: 12px;
        }

            .dashboard-section-title .title {
                font-size: .95rem;
                font-weight: 800;
                color: #0f172a;
                margin: 0;
                line-height: 1;
            }

            .dashboard-section-title .badge-soft {
                font-size: .72rem;
                font-weight: 800;
                padding: .22rem .65rem;
                border-radius: 999px;
                background: rgba(15,23,42,.06);
                color: #475569;
                white-space: nowrap;
            }

            .dashboard-section-title .line {
                flex: 1;
                height: 1px;
                background: linear-gradient(90deg, rgba(15,23,42,.18), rgba(15,23,42,0));
            }

        .dashboard-section .row:last-child {
            margin-bottom: 0;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>İnsan Kaynakları Yönetim Paneli</h3>
                <p class="text-subtitle text-muted">
                    Sistem genel durumunu ve özet istatistikleri görüntüleyin.
                </p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Genel Bakış</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

