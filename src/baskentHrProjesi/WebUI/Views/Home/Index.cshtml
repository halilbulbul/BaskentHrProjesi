@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/echarts@5/dist/echarts.min.js"></script>

    <script>
        function setPeriodBadges() {
            const d = new Date();

            const daily = new Intl.DateTimeFormat("tr-TR", { day: "2-digit", month: "long", year: "numeric" }).format(d);

            let monthYear = new Intl.DateTimeFormat("tr-TR", { month: "long", year: "numeric" }).format(d);
            monthYear = monthYear.charAt(0).toUpperCase() + monthYear.slice(1);

            const elCompany = document.getElementById("badge-company-period");
            if (elCompany) elCompany.textContent = `Günlük (${daily})`;

            const elMine = document.getElementById("badge-mine-period");
            if (elMine) elMine.textContent = `Aylık (${monthYear})`;
        }

        function formatTime(value) {
            const d = new Date(value);
            return d.toLocaleTimeString("tr-TR", { hour: "2-digit", minute: "2-digit" });
        }

        function formatDate(value) {
            const d = new Date(value);
            return d.toLocaleDateString("tr-TR", { year: "numeric", month: "2-digit", day: "2-digit" });
        }

        function toKeyDate(dt) {
            const y = dt.getFullYear();
            const m = String(dt.getMonth() + 1).padStart(2, "0");
            const d = String(dt.getDate()).padStart(2, "0");
            return `${y}-${m}-${d}`;
        }

        async function safeJsonFetch(url, defaultValue) {
            try {
                const resp = await fetch(url, { headers: { "Accept": "application/json" } });

                if (!resp.ok) {
                    console.warn("Fetch HTTP " + resp.status + " ->", url);
                    return defaultValue;
                }

                const ct = resp.headers.get("content-type") || "";
                if (!ct.includes("application/json")) {
                    console.warn("Non-JSON response ->", url, "content-type:", ct);
                    return defaultValue;
                }

                return await resp.json();
            } catch (err) {
                console.warn("Fetch error ->", url, err);
                return defaultValue;
            }
        }

        function renderDepartmentDistributionList(deptList) {
            var container = document.getElementById("departmentDistributionList");
            if (!container) return;

            container.innerHTML = "";

            if (!deptList || deptList.length === 0) {
                container.innerHTML = '<p class="text-muted mb-0">Veri bulunamadı.</p>';
                return;
            }

            var max = deptList.reduce(function (m, d) {
                return Math.max(m, d.count || 0);
            }, 1);

            deptList.forEach(function (d) {
                var count = Number(d.count) || 0;
                var pct = Math.round(count * 100 / max);

                var row = document.createElement("div");
                row.className = "mb-2";

                row.innerHTML =
                    '<div class="d-flex justify-content-between align-items-center mb-1">' +
                    '<span>' + d.name + '</span>' +
                    '<span class="fw-bold">' + count + '</span>' +
                    '</div>' +
                    '<div class="progress" style="height: 6px;">' +
                    '<div class="progress-bar" role="progressbar" style="width: ' + pct + '%;" ' +
                    'aria-valuenow="' + pct + '" aria-valuemin="0" aria-valuemax="100"></div>' +
                    '</div>';

                container.appendChild(row);
            });
        }

        function renderDepartmentDailyChart(depData) {
            var wrapper = document.getElementById("trend-chart-wrapper");
            var container = document.getElementById("trend-chart");
            if (!container) return;

            container.innerHTML = "";

            if (!depData || depData.length === 0) {
                container.innerHTML = '<p class="text-muted mb-0">Veri bulunamadı.</p>';
                return;
            }

            var chart = echarts.getInstanceByDom(container);
            if (chart) chart.dispose();

            var depOrder = [];
            var depMap = {};

            depData.forEach(function (d) {
                var name = d.departmentName;
                if (!depMap[name]) {
                    depMap[name] = { present: 0, absent: 0, leave: 0, late: 0 };
                    depOrder.push(name);
                }
                depMap[name].present += Number(d.present) || 0;
                depMap[name].absent += Number(d.absent) || 0;
                depMap[name].leave += Number(d.leave) || 0;
                depMap[name].late += Number(d.late) || 0;
            });

            var labels = depOrder;
            var presentData = depOrder.map(function (n) { return depMap[n].present; });
            var absentData = depOrder.map(function (n) { return depMap[n].absent; });
            var leaveData = depOrder.map(function (n) { return depMap[n].leave; });
            var lateData = depOrder.map(function (n) { return depMap[n].late; });

            if (wrapper) {
                var baseWidth = labels.length * 80;
                container.style.width = Math.max(baseWidth, wrapper.clientWidth || 0) + "px";
            }

            chart = echarts.init(container);

            var labelOption = {
                show: true,
                position: 'top',
                distance: 15,
                align: 'left',
                verticalAlign: 'middle',
                rotate: 0,
                fontSize: 15,
                rich: { name: {} }
            };

            var option = {
                tooltip: { trigger: 'axis', axisPointer: { type: 'shadow' } },
                legend: { data: ['Mevcut', 'Devamsız', 'İzinde', 'Geç Gelen'], textStyle: { fontSize: 15 } },
                grid: { left: 0, right: 0, top: 60, bottom: 0, containLabel: true },
                xAxis: [{
                    type: 'category',
                    axisTick: { show: false },
                    axisLabel: { fontSize: 18, rotate: 0 },
                    data: labels
                }],
                yAxis: [{ type: 'value', axisLabel: { fontSize: 12 } }],
                series: [
                    { name: 'Mevcut',    type: 'bar', barGap: 0, label: labelOption, data: presentData, itemStyle: { color: '#198754' } }, // yeşil
                    { name: 'Devamsız',  type: 'bar',             label: labelOption, data: absentData,  itemStyle: { color: '#dc3545' } }, // kırmızı
                    { name: 'İzinde',    type: 'bar',             label: labelOption, data: leaveData,   itemStyle: { color: '#0d6efd' } }, // mavi
                    { name: 'Geç Gelen', type: 'bar',             label: labelOption, data: lateData,    itemStyle: { color: '#ffc107' } }  // sarı
                ]
            };

            chart.setOption(option);
            window.addEventListener('resize', function () { chart.resize(); });
        }

        function renderNameList(items, listId) {
            var ul = document.getElementById(listId);
            if (!ul) return;

            ul.innerHTML = "";

            if (!items || items.length === 0) {
                ul.innerHTML = '<li class="today-status-empty">Kayıt yok</li>';
                return;
            }

            items.forEach(function (x) {
                var li = document.createElement("li");
                li.className = "today-status-item";

                var dot = document.createElement("div");
                dot.className = "today-status-dot";

                if (listId.indexOf("present") >= 0) dot.classList.add("present");
                else if (listId.indexOf("absent") >= 0) dot.classList.add("absent");
                else if (listId.indexOf("leave") >= 0) dot.classList.add("leave");
                else if (listId.indexOf("late") >= 0) dot.classList.add("late");

                var span = document.createElement("span");
                span.textContent = (x.fullName ?? x.FullName ?? "");

                if (dot.classList.length > 1) li.appendChild(dot);

                li.appendChild(span);
                ul.appendChild(li);
            });
        }

        async function loadDashboardData() {
            try {
                let summary = {};
                let isAdmin = false;

                // 1) ÖZET ÖNCE
                summary = await safeJsonFetch('@Url.Action("GetSummary", "Home")', {});
                isAdmin = summary.isAdmin === true;

                // 2) Admin / Personel görünürlüğü
                const rowMy = document.getElementById("row-my-monthly-summary");
                if (rowMy) rowMy.style.display = "";

                if (!isAdmin) {
                    document.querySelectorAll(".admin-only").forEach(function (el) {
                        el.style.display = "none";
                    });
                } else {
                    const elActive = document.getElementById("stat-activeEmployees");
                    if (elActive) elActive.textContent = summary.activeEmployeeCount || 0;

                    const elLeaves = document.getElementById("stat-openLeaves");
                    if (elLeaves) elLeaves.textContent = summary.openLeaveCount || 0;

                    const elNewHires = document.getElementById("stat-newHires");
                    if (elNewHires) elNewHires.textContent = summary.newHireCount || 0;

                    const elLate = document.getElementById("stat-lateEmployees");
                    if (elLate) elLate.textContent = summary.lateEmployeeCount || 0;
                }

                // 3) Ortak datalar
                const [status, birthdays, lastEntriesR] = await Promise.all([
                    safeJsonFetch('@Url.Action("GetEmployeeStatus", "Home")', {}),
                    safeJsonFetch('@Url.Action("GetUpcomingBirthdays", "Home")', {}),
                    safeJsonFetch('@Url.Action("GetLastEntries", "Home")', {})
                ]);

                const presentEmployees = status.presentEmployees || status.PresentEmployees || [];
                const absentEmployees = status.absentEmployees || status.AbsentEmployees || [];
                const leaveEmployees = status.leaveEmployees || status.LeaveEmployees || [];
                const upcomingBirthdays = birthdays.upcomingBirthdays || birthdays.UpcomingBirthdays || [];

                const elPresCount = document.getElementById("today-present-count");
                if (elPresCount) elPresCount.textContent = presentEmployees.length.toString();

                const elAbsCount = document.getElementById("today-absent-count");
                if (elAbsCount) elAbsCount.textContent = absentEmployees.length.toString();

                const elLeaveCount = document.getElementById("today-leave-count");
                if (elLeaveCount) elLeaveCount.textContent = leaveEmployees.length.toString();

                const elBirthCount = document.getElementById("upcoming-birthday-count");
                if (elBirthCount) elBirthCount.textContent = upcomingBirthdays.length.toString();

                renderNameList(presentEmployees, "today-present-list");
                renderNameList(absentEmployees, "today-absent-list");
                renderNameList(leaveEmployees, "today-leave-list");
                renderNameList(upcomingBirthdays, "upcoming-birthday-list");

                // === GÜNLÜK GRUPLU PUANTAJ TABLOSU (KÜÇÜKTEN -> BÜYÜĞE) ===
                const tbody = document.getElementById("lastTransactionsBody");
                if (tbody) {
                    tbody.innerHTML = "";

                    const lastEntriesList = Array.isArray(lastEntriesR)
                        ? lastEntriesR
                        : (lastEntriesR.lastEntries || lastEntriesR.LastEntries || lastEntriesR.items || []);

                    const map = {}; // dateKey -> { employeeName, inTime, outTime }

                    lastEntriesList.forEach(function (item) {
                        const empName = item.employeeName || item.EmployeeName || "";
                        const evTimeRaw = item.eventTime || item.EventTime;
                        const direction = (item.direction || item.Direction || "").toString().toLowerCase();
                        if (!evTimeRaw) return;

                        const evTime = new Date(evTimeRaw);
                        if (isNaN(evTime.getTime())) return;

                        const key = toKeyDate(evTime);

                        if (!map[key]) map[key] = { employeeName: empName, inTime: null, outTime: null };

                        if (direction === "out") {
                            if (!map[key].outTime || evTime > map[key].outTime) map[key].outTime = evTime;
                        } else {
                            if (!map[key].inTime || evTime < map[key].inTime) map[key].inTime = evTime;
                        }

                        if (!map[key].employeeName && empName) map[key].employeeName = empName;
                    });

                    const keys = Object.keys(map).sort((a, b) => a.localeCompare(a)); // ESKİ -> YENİ

                    if (keys.length === 0) {
                        tbody.innerHTML = '<tr><td colspan="4" class="text-muted">Kayıt yok</td></tr>';
                    } else {
                        keys.forEach(function (k) {
                            const g = map[k];
                            const dateObj = new Date(k + "T00:00:00");

                            const tr = document.createElement("tr");

                            const tdPerson = document.createElement("td");
                            tdPerson.className = "col-3";
                            tdPerson.textContent = g.employeeName || "-";

                            const tdDate = document.createElement("td");
                            tdDate.textContent = formatDate(dateObj);

                            const tdIn = document.createElement("td");
                            tdIn.textContent = g.inTime ? formatTime(g.inTime) : "—";
                            tdIn.classList.add("text-success");

                            const tdOut = document.createElement("td");
                            tdOut.textContent = g.outTime ? formatTime(g.outTime) : "—";
                            tdOut.classList.add("text-danger");

                            tr.appendChild(tdPerson);
                            tr.appendChild(tdDate);
                            tr.appendChild(tdIn);
                            tr.appendChild(tdOut);

                            tbody.appendChild(tr);
                        });
                    }
                }

                // 4) HERKES: aylık özet
                const my = await safeJsonFetch('@Url.Action("GetMyMonthlySummary", "Home")', {});
                const overtime = (my.overtimeMinutes ?? my.OvertimeMinutes ?? 0);
                const late = (my.lateArrivalMinutes ?? my.LateArrivalMinutes ?? 0);
                const leave = (my.usedLeaveDays ?? my.UsedLeaveDays ?? 0);

                const elMyOver = document.getElementById("my-overtime-minutes");
                if (elMyOver) elMyOver.textContent = overtime.toString();

                const elMyLate = document.getElementById("my-late-minutes");
                if (elMyLate) elMyLate.textContent = late.toString();

                const elMyLeave = document.getElementById("my-used-leave-days");
                if (elMyLeave) elMyLeave.textContent = leave.toString();

                // 5) SADECE ADMIN: departman verileri
                if (isAdmin) {
                    const [deptCounts, deptDailyTrend] = await Promise.all([
                        safeJsonFetch('@Url.Action("GetDepartmentCounts", "Home")', {}),
                        safeJsonFetch('@Url.Action("GetDepartmentDailyTrend", "Home")', {})
                    ]);

                    if (deptDailyTrend && (deptDailyTrend.departmentDailyTrend || deptDailyTrend.DepartmentDailyTrend || deptDailyTrend.items)) {
                        const trendData = deptDailyTrend.departmentDailyTrend || deptDailyTrend.DepartmentDailyTrend || deptDailyTrend.items || [];
                        renderDepartmentDailyChart(trendData);
                    }

                    if (deptCounts && (deptCounts.departmentCounts || deptCounts.DepartmentCounts || deptCounts.items)) {
                        const countsData = deptCounts.departmentCounts || deptCounts.DepartmentCounts || deptCounts.items || [];
                        renderDepartmentDistributionList(countsData);
                    }
                }
            } catch (e) {
                console.error("Dashboard load error", e);
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            setPeriodBadges();
            loadDashboardData();
        });
    </script>
}
