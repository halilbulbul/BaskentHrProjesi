@{
    ViewData["Title"] = "Puantaj Özetleri";
    ViewData["Subtitle"] = "Günlük puantaj özetlerini görüntüleyin ve yönetin.";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        /* sadece bu sayfa: hesapla + expand */
        body.no-permission #btnCalculate,
        body.no-permission #btnDoCalculate {
            pointer-events: none;
            opacity: .55;
        }

        body.no-permission #calcTimesheetModal :is(select,input,button,textarea) {
            pointer-events: none;
            opacity: .55;
        }

        body.no-permission #timesheetsTable .dt-toggle {
            pointer-events: none;
            opacity: .35;
            cursor: not-allowed;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>Puantaj Özetleri</h3>
                <p class="text-subtitle text-muted">@ViewData["Subtitle"]</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Puantaj Özetleri</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="small text-muted">@ViewData["Subtitle"]</div>
        </div>
        <div class="d-flex gap-2">
            <button id="btnCalculate" type="button" class="btn btn-outline-secondary btn-sm d-inline-flex align-items-center gap-1 px-3 shadow-sm">
                <i class="bi bi-calculator-fill"></i>
                <span>Puantaj Hesapla</span>
            </button>
        </div>
    </div>
    <div class="card-body">
        <table id="timesheetsTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th style="width:40px;"></th>
                    <th style="width:60px;">#</th>
                    <th style="width:220px;">Personel</th>
                    <th style="width:120px;">Dönem</th>
                    <th style="width:120px;">Plan Toplam (gün)</th>
                    <th style="width:120px;">Fiili Toplam (gün)</th>
                    <th style="width:120px;">Fazla Toplam (gün)</th>
                    <th style="width:120px;">Eksik Toplam (gün)</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="calcTimesheetModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Aylık Puantaj Hesapla</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-12">
                        <label for="CalcEmployeeIds" class="form-label">Personeller</label>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="checkbox" id="ChkSelectAllEmployees" />
                            <label class="form-check-label" for="ChkSelectAllEmployees">Tümünü seç</label>
                        </div>
                        <select id="CalcEmployeeIds" class="form-select" multiple size="8"></select>
                        <div class="form-text">Bir veya daha fazla Personel seçebilirsiniz.</div>
                    </div>
                    <div class="col-6">
                        <label for="CalcYear" class="form-label">Yıl</label>
                        <input type="number" id="CalcYear" class="form-control" min="2000" max="2100" />
                    </div>
                    <div class="col-6">
                        <label for="CalcMonth" class="form-label">Ay</label>
                        <select id="CalcMonth" class="form-select">
                            <option value="">Ay seçin</option>
                            <option value="1">Ocak</option>
                            <option value="2">Şubat</option>
                            <option value="3">Mart</option>
                            <option value="4">Nisan</option>
                            <option value="5">Mayıs</option>
                            <option value="6">Haziran</option>
                            <option value="7">Temmuz</option>
                            <option value="8">Ağustos</option>
                            <option value="9">Eylül</option>
                            <option value="10">Ekim</option>
                            <option value="11">Kasım</option>
                            <option value="12">Aralık</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnDoCalculate">
                    <i class="bi bi-calculator me-1"></i>Hesapla
                </button>
            </div>
        </div>
    </div>
</div>

<!-- TOAST -->
<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');
                switch ((variant || 'danger').toLowerCase()) {
                    case 'success': toastEl.classList.add('bg-success', 'text-white'); break;
                    case 'warning': toastEl.classList.add('bg-warning', 'text-dark'); break;
                    case 'info': toastEl.classList.add('bg-info', 'text-dark'); break;
                    case 'secondary': toastEl.classList.add('bg-secondary', 'text-white'); break;
                    default: toastEl.classList.add('bg-danger', 'text-white'); break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) { alert(message || ''); return; }
                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');
                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                toast.show();
            }

            function isNoPermission(xhr) {
                var s = (xhr && typeof xhr.status !== 'undefined') ? xhr.status : 0;
                return s === 401 || s === 403 || s === 0 || s >= 500;
            }

            function applyNoPermissionUi() {
                $('body').addClass('no-permission');
                $('#btnCalculate,#btnDoCalculate').prop('disabled', true).addClass('disabled');
                $('#timesheetsTable .dt-toggle').prop('disabled', true).addClass('disabled');

                // modal içi (sadece bu sayfa)
                $('#calcTimesheetModal').find('select,input,button,textarea')
                    .prop('disabled', true).addClass('disabled');
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;
                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');
                applyNoPermissionUi();
            }

            function handleFail(xhr, msg) {
                if (isNoPermission(xhr)) setNoPermission('yetkiniz bulunmamaktadır.');
                else showPopup(msg || 'İşlem sırasında hata oluştu.', 'danger');
            }

            var employeeCache = {};
            var shiftCache = {};
            var leaveCache = {};
            var allDailyItems = [];
            var table;

            function minutesToDays(min) { return (min || 0) / 480; }
            function formatDays(min) {
                var v = minutesToDays(min);
                return v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }
            function minutesToHours(min) { return (min || 0) / 60; }
            function formatHours(min) {
                var v = minutesToHours(min);
                return v.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function preloadCaches() {
                $.ajax({
                    url: '@Url.Action("GetList", "Employees")',
                    type: 'GET',
                    async: false
                }).done(function (res) {
                    employeeCache = {};
                    $.each(res.data || [], function (_, x) { employeeCache[x.id] = x; });
                }).fail(function (xhr) { handleFail(xhr, 'Personel listesi alınamadı.'); });

                $.ajax({
                    url: '@Url.Action("GetList", "Shifts")',
                    type: 'GET',
                    async: false
                }).done(function (res) {
                    shiftCache = {};
                    $.each(res.data || [], function (_, x) { shiftCache[x.id] = x; });
                }).fail(function (xhr) { handleFail(xhr, 'Mesai listesi alınamadı.'); });

                $.ajax({
                    url: '@Url.Action("GetList", "EmployeeLeaves")',
                    type: 'GET',
                    async: false
                }).done(function (res) {
                    leaveCache = {};
                    $.each(res.data || [], function (_, x) { leaveCache[x.id] = x; });
                }).fail(function (xhr) { handleFail(xhr, 'İzin listesi alınamadı.'); });
            }

            function fillEmployeeMulti($el, data, selectedIds) {
                $el.empty();
                if (!Array.isArray(selectedIds)) selectedIds = [];
                $.each(data || [], function (_, item) {
                    var opt = $('<option>', {
                        value: item.id,
                        text: (item.employeeNumber || '') + ' - ' + (item.firstName || '') + ' ' + (item.lastName || '')
                    });
                    if (selectedIds.indexOf(String(item.id)) >= 0) opt.attr('selected', 'selected');
                    $el.append(opt);
                });
                applySelectAllCheckbox();
            }

            function loadCalcEmployees(selectedIds) {
                return $.get('@Url.Action("GetList", "Employees")')
                    .done(function (res) { fillEmployeeMulti($('#CalcEmployeeIds'), res.data, selectedIds); })
                    .fail(function (xhr) { handleFail(xhr, 'Personel listesi alınamadı.'); });
            }

            function applySelectAllCheckbox() {
                var chk = $('#ChkSelectAllEmployees');
                var $sel = $('#CalcEmployeeIds');
                if (chk.prop('checked')) {
                    var allValues = [];
                    $sel.find('option').each(function () { if (this.value) allValues.push(this.value); });
                    $sel.val(allValues);
                }
            }

            function openCalcModal() {
                if (noPermission) return;

                var now = new Date();
                $('#CalcYear').val(now.getFullYear());
                $('#CalcMonth').val(now.getMonth() + 1);
                $('#ChkSelectAllEmployees').prop('checked', false);

                $.when(loadCalcEmployees([])).done(function () {
                    if (noPermission) return;
                    var modal = new bootstrap.Modal(document.getElementById('calcTimesheetModal'));
                    modal.show();
                });
            }

            function monthName(m) {
                var names = { 1: 'Ocak', 2: 'Şubat', 3: 'Mart', 4: 'Nisan', 5: 'Mayıs', 6: 'Haziran', 7: 'Temmuz', 8: 'Ağustos', 9: 'Eylül', 10: 'Ekim', 11: 'Kasım', 12: 'Aralık' };
                return names[m] || m;
            }

            function buildSummary(dailyItems) {
                var groups = {};
                $.each(dailyItems || [], function (_, item) {
                    if (!item || !item.workDate || !item.employeeId) return;

                    var dt = new Date(item.workDate);
                    if (isNaN(dt)) return;

                    var y = dt.getFullYear();
                    var m = dt.getMonth() + 1;
                    var key = item.employeeId + '|' + y + '|' + m;

                    if (!groups[key]) {
                        groups[key] = {
                            key: key,
                            employeeId: item.employeeId,
                            year: y,
                            month: m,
                            plannedTotal: 0,
                            actualTotal: 0,
                            overtimeTotal: 0,
                            missingTotal: 0,
                            details: []
                        };
                    }

                    groups[key].plannedTotal += item.plannedMinutes || 0;
                    groups[key].actualTotal += item.actualMinutes || 0;
                    groups[key].overtimeTotal += item.overtimeMinutes || 0;
                    groups[key].missingTotal += item.missingMinutes || 0;
                    groups[key].details.push(item);
                });

                var list = [];
                $.each(groups, function (_, g) { list.push(g); });

                list.sort(function (a, b) {
                    if (a.employeeId === b.employeeId) {
                        if (a.year === b.year) return a.month - b.month;
                        return a.year - b.year;
                    }
                    return a.employeeId - b.employeeId;
                });

                return list;
            }

            function formatDetailRow(summaryRow) {
                var rowsHtml = '';
                var details = summaryRow.details || [];

                details.sort(function (a, b) {
                    return new Date(a.workDate) - new Date(b.workDate);
                });

                $.each(details, function (_, d) {
                    var date = '';
                    if (d.workDate) {
                        var dt = new Date(d.workDate);
                        if (!isNaN(dt)) {
                            var day = String(dt.getDate()).padStart(2, '0');
                            var month = String(dt.getMonth() + 1).padStart(2, '0');
                            var year = dt.getFullYear();
                            date = day + '.' + month + '.' + year;
                        } else date = d.workDate;
                    }

                    var shiftId = (d.shiftId || d.ShiftId || null);
                    var ruleText = '';
                    if (shiftId) {
                        var s = shiftCache[shiftId];
                        ruleText = s ? (s.name || ('Set #' + s.id)) : shiftId;
                    }

                    rowsHtml +=
                        '<tr>' +
                        '<td>' + (date || '') + '</td>' +
                        '<td>' + (ruleText || '') + '</td>' +
                        '<td class="text-end">' + formatHours(d.plannedMinutes || 0) + '</td>' +
                        '<td class="text-end">' + formatHours(d.actualMinutes || 0) + '</td>' +
                        '<td class="text-end">' + formatHours(d.overtimeMinutes || 0) + '</td>' +
                        '<td class="text-end">' + formatHours(d.missingMinutes || 0) + '</td>' +
                        '<td>' + (d.status || '') + '</td>' +
                        '</tr>';
                });

                return '' +
                    '<table class="table table-sm table-striped mb-0">' +
                    '<thead><tr>' +
                    '<th style="width:120px;">Tarih</th>' +
                    '<th style="width:160px;">Mesai Tipi</th>' +
                    '<th style="width:110px;" class="text-end">Plan (saat)</th>' +
                    '<th style="width:110px;" class="text-end">Fiili (saat)</th>' +
                    '<th style="width:110px;" class="text-end">Fazla (saat)</th>' +
                    '<th style="width:110px;" class="text-end">Eksik (saat)</th>' +
                    '<th style="width:120px;">Durum</th>' +
                    '</tr></thead>' +
                    '<tbody>' + rowsHtml + '</tbody>' +
                    '</table>';
            }

            function initTable() {
                table = $('#timesheetsTable').DataTable({
                    data: [],
                    columns: [
                        {
                            data: null,
                            className: 'details-control text-center',
                            orderable: false,
                            width: '40px',
                            defaultContent: '<button type="button" class="btn btn-sm btn-outline-secondary dt-toggle">+</button>'
                        },
                        {
                            data: null,
                            width: '60px',
                            className: 'text-center',
                            render: function (d, t, r, m) { return m.row + 1; }
                        },
                        {
                            data: 'employeeId',
                            width: '220px',
                            render: function (d) {
                                if (!d) return '';
                                var e = employeeCache[d];
                                if (!e) return d;
                                var txt = (e.employeeNumber ? e.employeeNumber + ' - ' : '') + (e.firstName || '') + ' ' + (e.lastName || '');
                                return txt.trim();
                            }
                        },
                        {
                            data: null,
                            width: '120px',
                            render: function (d, t, r) { return monthName(r.month) + ' ' + r.year; }
                        },
                        {
                            data: 'plannedTotal',
                            width: '120px',
                            className: 'text-end',
                            render: function (d) { return '<span class="text-secondary fw-semibold">' + formatDays(d) + '</span>'; }
                        },
                        {
                            data: 'actualTotal',
                            width: '120px',
                            className: 'text-end',
                            render: function (d) { return '<span class="text-primary fw-semibold">' + formatDays(d) + '</span>'; }
                        },
                        {
                            data: 'overtimeTotal',
                            width: '120px',
                            className: 'text-end',
                            render: function (d) {
                                var cls = (minutesToDays(d) > 0) ? 'text-success fw-semibold' : 'text-muted';
                                return '<span class="' + cls + '">' + formatDays(d) + '</span>';
                            }
                        },
                        {
                            data: 'missingTotal',
                            width: '120px',
                            className: 'text-end',
                            render: function (d) {
                                var cls = (minutesToDays(d) > 0) ? 'text-danger fw-semibold' : 'text-muted';
                                return '<span class="' + cls + '">' + formatDays(d) + '</span>';
                            }
                        }
                    ],
                    order: [],
                    language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                    drawCallback: function () {
                        if (!noPermission) return;
                        applyNoPermissionUi();
                    }
                });

                $('#timesheetsTable tbody').on('click', 'td.details-control .dt-toggle', function () {
                    if (noPermission) return;

                    var tr = $(this).closest('tr');
                    var row = table.row(tr);
                    var btn = $(this);

                    if (row.child.isShown()) {
                        row.child.hide();
                        tr.removeClass('shown');
                        btn.text('+');
                    } else {
                        row.child(formatDetailRow(row.data())).show();
                        tr.addClass('shown');
                        btn.text('-');
                    }
                });
            }

            function refreshTableFromDaily(dailyItems) {
                var summary = buildSummary(dailyItems || []);
                table.clear();
                table.rows.add(summary);
                table.draw();
            }

            function loadInitialDaily() {
                $.get('@Url.Action("GetList", "Timesheets")')
                    .done(function (res) {
                        var rows = (res && res.data) ? res.data : [];
                        allDailyItems = rows;
                        refreshTableFromDaily(allDailyItems);
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Puantaj verisi alınamadı.');
                    });
            }

            preloadCaches();
            initTable();
            loadInitialDaily();

            $('#btnCalculate').on('click', function () {
                openCalcModal();
            });

            $('#ChkSelectAllEmployees').on('change', function () {
                if (noPermission) return;

                var $sel = $('#CalcEmployeeIds');
                if ($(this).prop('checked')) {
                    var allValues = [];
                    $sel.find('option').each(function () { if (this.value) allValues.push(this.value); });
                    $sel.val(allValues);
                } else {
                    $sel.val([]);
                }
            });

            $('#btnDoCalculate').on('click', function () {
                if (noPermission) return;

                var employeeIds = $('#CalcEmployeeIds').val() || [];
                var year = $('#CalcYear').val();
                var month = $('#CalcMonth').val();

                if (employeeIds.length === 0 || !year || !month) {
                    showPopup('En az bir Personel, yıl ve ay seçilmelidir.', 'warning');
                    return;
                }

                $.ajax({
                    url: '@Url.Action("CalculateMonthly", "Timesheets")',
                    type: 'POST',
                    traditional: true,
                    data: { EmployeeIds: employeeIds, Year: year, Month: month }
                }).done(function (res) {
                    if (res && res.success) {
                        var modalEl = document.getElementById('calcTimesheetModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();

                        if (res.data) {
                            allDailyItems = res.data;
                            refreshTableFromDaily(allDailyItems);
                        }

                        showPopup('Hesaplama tamamlandı.', 'success');
                    } else {
                        showPopup((res && res.message) || 'Hesaplama sırasında hata oluştu.', 'danger');
                    }
                }).fail(function (xhr) {
                    handleFail(xhr, 'Hesaplama isteği sırasında hata oluştu.');
                });
            });
        });
    </script>
}
