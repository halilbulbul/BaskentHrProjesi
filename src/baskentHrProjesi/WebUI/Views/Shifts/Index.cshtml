@{
    ViewData["Title"] = "Mesailer";
    ViewData["Subtitle"] = "Mesai kurallarını görüntüleyin ve yönetin.";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />
    <style>
        .table-action-icon {
            border: 0;
            background: transparent;
            padding: 0.15rem 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

            .table-action-icon i {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .table-action-icon + .table-action-icon {
                margin-left: 0.4rem;
            }

            .table-action-icon.text-warning:hover i,
            .table-action-icon.text-danger:hover i {
                opacity: 0.8;
            }

        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        body.no-permission #btnAdd {
            pointer-events: none;
            opacity: .55;
        }

        body.no-permission #ShiftsTable .table-action-icon {
            pointer-events: none;
            opacity: .35;
            cursor: not-allowed;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>@ViewData["Title"]</h3>
                <p class="text-subtitle text-muted">@ViewData["Subtitle"]</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Mesailer</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="small text-muted">@ViewData["Subtitle"]</div>
        </div>
        <button id="btnAdd" type="button" class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Yeni Mesai Tanımı</span>
        </button>
    </div>
    <div class="card-body">
        <table id="ShiftsTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th>Ad</th>
                    <th style="width:110px;">Mesai Baş.</th>
                    <th style="width:110px;">Mesai Bit.</th>
                    <th style="width:110px;">Mola Baş.</th>
                    <th style="width:110px;">Mola Bit.</th>
                    <th style="width:110px;">Erk.Gel. Tol.</th>
                    <th style="width:110px;">Geç.Gel. Tol.</th>
                    <th style="width:110px;">Erk.Çık. Tol.</th>
                    <th style="width:110px;">Geç.Çık. Tol.</th>
                    <th style="width:140px;">İşlemler</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="ShiftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="ShiftModalLabel">Yeni Mesai Tanımı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="ShiftId" />

                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="Name" class="form-label">Ad</label>
                        <input type="text" id="Name" class="form-control" />
                        <div id="NameError" class="field-error text-danger small mt-1"></div>
                    </div>

                    <div class="col-md-3">
                        <label for="ShiftStartTime" class="form-label">Mesai Baş.</label>
                        <input type="time" id="ShiftStartTime" class="form-control" />
                        <div id="ShiftStartTimeError" class="field-error text-danger small mt-1"></div>
                    </div>

                    <div class="col-md-3">
                        <label for="ShiftEndTime" class="form-label">Mesai Bit.</label>
                        <input type="time" id="ShiftEndTime" class="form-control" />
                        <div id="ShiftEndTimeError" class="field-error text-danger small mt-1"></div>
                    </div>

                    <div class="col-md-3">
                        <label for="BreakStartTime" class="form-label">Mola Baş.</label>
                        <input type="time" id="BreakStartTime" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label for="BreakEndTime" class="form-label">Mola Bit.</label>
                        <input type="time" id="BreakEndTime" class="form-control" />
                    </div>

                    <div class="col-md-3">
                        <label for="EarlyArrivalToleranceMinutes" class="form-label">Erk.Gel. Tol.(dk)</label>
                        <input type="number" id="EarlyArrivalToleranceMinutes" class="form-control" min="0" />
                    </div>

                    <div class="col-md-3">
                        <label for="LateArrivalToleranceMinutes" class="form-label">Geç.Gel. Tol.(dk)</label>
                        <input type="number" id="LateArrivalToleranceMinutes" class="form-control" min="0" />
                    </div>

                    <div class="col-md-3">
                        <label for="EarlyLeaveToleranceMinutes" class="form-label">Erk.Çık. Tol.(dk)</label>
                        <input type="number" id="EarlyLeaveToleranceMinutes" class="form-control" min="0" />
                    </div>

                    <div class="col-md-3">
                        <label for="LateLeaveToleranceMinutes" class="form-label">Geç.Çık. Tol.(dk)</label>
                        <input type="number" id="LateLeaveToleranceMinutes" class="form-control" min="0" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="btnSave">
                    <i class="bi bi-save me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteShiftModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Silme Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Bu mesai tanımını silmek istediğinize emin misiniz?</p>
                <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                <input type="hidden" id="DeleteShiftId" />
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnConfirmDelete">
                    <i class="bi bi-trash me-1"></i>Sil
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');

                switch ((variant || 'danger').toLowerCase()) {
                    case 'success': toastEl.classList.add('bg-success', 'text-white'); break;
                    case 'warning': toastEl.classList.add('bg-warning', 'text-dark'); break;
                    case 'info': toastEl.classList.add('bg-info', 'text-dark'); break;
                    case 'secondary': toastEl.classList.add('bg-secondary', 'text-white'); break;
                    default: toastEl.classList.add('bg-danger', 'text-white'); break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) {
                    alert(message || '');
                    return;
                }

                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');

                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });

                toast.show();
            }

            function isNoPermission(xhr) {
                var s = (xhr && typeof xhr.status !== 'undefined') ? xhr.status : 0;
                return s === 401 || s === 403 || s === 0 || s >= 500;
            }

            function applyNoPermissionUi() {
                $('#btnAdd').prop('disabled', true).addClass('disabled');
                $('body').addClass('no-permission');
                $('#ShiftsTable').find('.btn-edit,.btn-delete').prop('disabled', true).addClass('disabled');
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;
                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');
                applyNoPermissionUi();
            }

            function handleFail(xhr, msg) {
                if (isNoPermission(xhr)) setNoPermission(msg || 'yetkiniz bulunmamaktadır.');
                else showPopup(msg || 'İşlem sırasında hata oluştu.', 'danger');
            }

            var table = $('#ShiftsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetList", "Shifts")',
                    type: 'GET',
                    dataSrc: 'data',
                    error: function (xhr) {
                        handleFail(xhr, 'yetkiniz bulunmamaktadır.');
                    }
                },
                columns: [
                    {
                        data: null,
                        title: '#',
                        width: '70px',
                        className: 'text-center',
                        render: function (data, type, row, meta) { return meta.row + 1; }
                    },
                    { data: 'name', title: 'Ad', width: '150px' },
                    { data: 'shiftStartTime', title: 'Mesai Baş.', width: '110px', render: function (d) { return d ? String(d).substring(0, 5) : ''; } },
                    { data: 'shiftEndTime', title: 'Mesai Bit.', width: '110px', render: function (d) { return d ? String(d).substring(0, 5) : ''; } },
                    { data: 'breakStartTime', title: 'Mola Baş.', width: '110px', render: function (d) { return d ? String(d).substring(0, 5) : ''; } },
                    { data: 'breakEndTime', title: 'Mola Bit.', width: '110px', render: function (d) { return d ? String(d).substring(0, 5) : ''; } },
                    { data: 'earlyArrivalToleranceMinutes', title: 'Erk.Gel. Tol.', width: '110px' },
                    { data: 'lateArrivalToleranceMinutes', title: 'Geç.Gel. Tol.', width: '110px' },
                    { data: 'earlyLeaveToleranceMinutes', title: 'Erk.Çık. Tol.', width: '110px' },
                    { data: 'lateLeaveToleranceMinutes', title: 'Geç.Çık. Tol.', width: '110px' },
                    {
                        data: null,
                        title: 'İşlemler',
                        orderable: false,
                        searchable: false,
                        width: '140px',
                        className: 'text-end',
                        render: function (data, type, row) {
                            return `
                                <button class="table-action-icon text-warning btn-edit" data-id="${row.id}" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="table-action-icon text-danger btn-delete" data-id="${row.id}" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>`;
                        }
                    }
                ],
                paging: true,
                searching: true,
                info: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                drawCallback: function () {
                    if (!noPermission) return;
                    applyNoPermissionUi();
                }
            });

            function clearValidation() {
                $('#Name,#ShiftStartTime,#ShiftEndTime').removeClass('is-invalid');
                $('#NameError,#ShiftStartTimeError,#ShiftEndTimeError').removeClass('active').text('');
            }

            function showError(id, msg) {
                $(id).addClass('is-invalid');
                $(id + 'Error').addClass('active').text(msg);
            }

            function openCreateModal() {
                if (noPermission) return;

                $('#ShiftId').val('');
                $('#Name').val('');
                $('#ShiftStartTime').val('');
                $('#ShiftEndTime').val('');
                $('#BreakStartTime').val('');
                $('#BreakEndTime').val('');
                $('#EarlyArrivalToleranceMinutes').val('');
                $('#LateArrivalToleranceMinutes').val('');
                $('#EarlyLeaveToleranceMinutes').val('');
                $('#LateLeaveToleranceMinutes').val('');
                clearValidation();
                $('#ShiftModalLabel').text('Yeni Mesai Tanımı');
                var modal = new bootstrap.Modal(document.getElementById('ShiftModal'));
                modal.show();
            }

            function openEditModal(id) {
                if (noPermission) return;

                clearValidation();
                $.get('@Url.Action("Get", "Shifts")', { id: id })
                    .done(function (res) {
                        $('#ShiftId').val(res.id);
                        $('#Name').val(res.name || '');
                        $('#ShiftStartTime').val(res.shiftStartTime ? String(res.shiftStartTime).substring(0, 5) : '');
                        $('#ShiftEndTime').val(res.shiftEndTime ? String(res.shiftEndTime).substring(0, 5) : '');
                        $('#BreakStartTime').val(res.breakStartTime ? String(res.breakStartTime).substring(0, 5) : '');
                        $('#BreakEndTime').val(res.breakEndTime ? String(res.breakEndTime).substring(0, 5) : '');
                        $('#EarlyArrivalToleranceMinutes').val(res.earlyArrivalToleranceMinutes);
                        $('#LateArrivalToleranceMinutes').val(res.lateArrivalToleranceMinutes);
                        $('#EarlyLeaveToleranceMinutes').val(res.earlyLeaveToleranceMinutes);
                        $('#LateLeaveToleranceMinutes').val(res.lateLeaveToleranceMinutes);
                        $('#ShiftModalLabel').text('Mesai Tanımı Düzenle');
                        var modal = new bootstrap.Modal(document.getElementById('ShiftModal'));
                        modal.show();
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Kayıt okunamadı.');
                    });
            }

            $('#btnAdd').on('click', function () { openCreateModal(); });

            $('#ShiftsTable').on('click', '.btn-edit', function () {
                openEditModal($(this).data('id'));
            });

            var deleteModalEl = document.getElementById('deleteShiftModal');
            var deleteModal = new bootstrap.Modal(deleteModalEl);

            $('#ShiftsTable').on('click', '.btn-delete', function () {
                if (noPermission) return;
                $('#DeleteShiftId').val($(this).data('id'));
                deleteModal.show();
            });

            $('#btnConfirmDelete').on('click', function () {
                if (noPermission) return;

                var id = $('#DeleteShiftId').val();
                $.post('@Url.Action("Delete", "Shifts")', { id: id })
                    .done(function (res) {
                        if (res && res.success) {
                            deleteModal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Silme işlemi tamamlandı.', 'success');
                        } else {
                            showPopup((res && res.message) || 'Silme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Silme işlemi sırasında hata oluştu.');
                    });
            });

            $('#btnSave').on('click', function () {
                if (noPermission) return;

                clearValidation();

                var id = $('#ShiftId').val();
                var name = $('#Name').val().trim();
                var shiftStartTime = $('#ShiftStartTime').val();
                var shiftEndTime = $('#ShiftEndTime').val();
                var breakStartTime = $('#BreakStartTime').val();
                var breakEndTime = $('#BreakEndTime').val();
                var earlyArrivalToleranceMinutes = $('#EarlyArrivalToleranceMinutes').val();
                var lateArrivalToleranceMinutes = $('#LateArrivalToleranceMinutes').val();
                var earlyLeaveToleranceMinutes = $('#EarlyLeaveToleranceMinutes').val();
                var lateLeaveToleranceMinutes = $('#LateLeaveToleranceMinutes').val();

                var hasError = false;
                if (!name) { showError('#Name', 'Ad zorunludur.'); hasError = true; }
                if (!shiftStartTime) { showError('#ShiftStartTime', 'Mesai başlangıç zorunludur.'); hasError = true; }
                if (!shiftEndTime) { showError('#ShiftEndTime', 'Mesai bitiş zorunludur.'); hasError = true; }
                if (hasError) return;

                var url = id ? '@Url.Action("Update", "Shifts")' : '@Url.Action("Create", "Shifts")';

                var payload = {
                    id: id,
                    name: name,
                    shiftStartTime: shiftStartTime,
                    shiftEndTime: shiftEndTime,
                    breakStartTime: breakStartTime || null,
                    breakEndTime: breakEndTime || null,
                    earlyArrivalToleranceMinutes: earlyArrivalToleranceMinutes || 0,
                    lateArrivalToleranceMinutes: lateArrivalToleranceMinutes || 0,
                    earlyLeaveToleranceMinutes: earlyLeaveToleranceMinutes || 0,
                    lateLeaveToleranceMinutes: lateLeaveToleranceMinutes || 0
                };

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: payload
                }).done(function (res) {
                    if (res && res.success) {
                        var modalEl = document.getElementById('ShiftModal');
                        var modal = bootstrap.Modal.getInstance(modalEl);
                        modal.hide();
                        table.ajax.reload(null, false);
                        showPopup('Kayıt başarıyla kaydedildi.', 'success');
                    } else {
                        showPopup((res && res.message) || 'Kaydetme işlemi başarısız.', 'warning');
                    }
                }).fail(function (xhr) {
                    handleFail(xhr, 'Kaydetme işlemi sırasında hata oluştu.');
                });
            });
        });
    </script>
}
