@{
    ViewData["Title"] = "Kullanıcı Yetkileri";
    ViewData["Subtitle"] = "Kullanıcı - rol eşleştirmelerini görüntüleyin ve yönetin.";
}

@Html.AntiForgeryToken()

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <style>
        .table-action-icon {
            border: 0;
            background: transparent;
            padding: 0.15rem 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

            .table-action-icon i {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .table-action-icon + .table-action-icon {
                margin-left: 0.4rem;
            }

            .table-action-icon.text-warning:hover i,
            .table-action-icon.text-danger:hover i {
                opacity: 0.8;
            }

        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        body.no-permission #btnAdd,
        body.no-permission #userOperationClaimsTable .btn-edit,
        body.no-permission #userOperationClaimsTable .btn-delete {
            pointer-events: none;
            opacity: .55;
            cursor: not-allowed;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>Kullanıcı Yetkileri</h3>
                <p class="text-subtitle text-muted">@ViewData["Subtitle"]</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Kullanıcı Yetkileri</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="small text-muted">@ViewData["Subtitle"]</div>
        </div>

        <button id="btnAdd"
                type="button"
                class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Yeni Yetki</span>
        </button>
    </div>
    <div class="card-body">
        <table id="userOperationClaimsTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th>Personel</th>
                    <th style="width:140px;">İşlemler</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="userOperationClaimModal" tabindex="-1" aria-labelledby="userOperationClaimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userOperationClaimModalLabel">Yeni Yetki</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="UserOperationClaimUserId" />

                <div class="mb-3">
                    <label for="EmployeeSelect" class="form-label">Personel</label>
                    <select id="EmployeeSelect" class="form-select">
                        <option value="">Seçiniz</option>
                    </select>
                    <div id="EmployeeSelectError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">Yetki atanacak personeli seçiniz.</div>
                </div>

                <div class="mb-3">
                    <label for="OperationClaimSelect" class="form-label">Yetkiler</label>
                    <select id="OperationClaimSelect" class="form-select" multiple size="8"></select>
                    <div id="OperationClaimSelectError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">Birden fazla yetki seçebilirsiniz.</div>
                </div>
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary btn-sm" id="btnSave">
                    <i class="bi bi-save2 me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteUserOperationClaimModal" tabindex="-1" aria-labelledby="deleteUserOperationClaimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteUserOperationClaimModalLabel">Yetkileri Sil</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">Seçili kullanıcının TÜM yetkilerini silmek istediğinize emin misiniz?</p>
                <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                <input type="hidden" id="DeleteUserId" />
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteConfirm">
                    <i class="bi bi-trash me-1"></i>Sil
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;
            var table = null;

            var antiToken = $('input[name="__RequestVerificationToken"]').val();

            function postWithToken(url, data) {
                data = data || {};
                data.__RequestVerificationToken = antiToken;
                return $.ajax({
                    url: url,
                    type: 'POST',
                    headers: { 'RequestVerificationToken': antiToken },
                    traditional: true,
                    data: data
                });
            }

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');
                switch ((variant || 'danger').toLowerCase()) {
                    case 'success': toastEl.classList.add('bg-success', 'text-white'); break;
                    case 'warning': toastEl.classList.add('bg-warning', 'text-dark'); break;
                    case 'info': toastEl.classList.add('bg-info', 'text-dark'); break;
                    case 'secondary': toastEl.classList.add('bg-secondary', 'text-white'); break;
                    default: toastEl.classList.add('bg-danger', 'text-white'); break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) { alert(message || ''); return; }
                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');
                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });
                toast.show();
            }

            function isNoPermission(xhr) {
                var s = (xhr && typeof xhr.status !== 'undefined') ? xhr.status : 0;
                return s === 401 || s === 403 || s === 0 || s >= 500;
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;
                $('body').addClass('no-permission');
                $('#btnAdd').prop('disabled', true).addClass('disabled');
                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');
                if (table) table.rows().invalidate().draw(false);
            }

            function handleFail(xhr, msg) {
                if (isNoPermission(xhr)) setNoPermission('yetkiniz bulunmamaktadır.');
                else showPopup(msg || 'İşlem sırasında hata oluştu.', 'danger');
            }

            var $employeeSelect = $('#EmployeeSelect');
            var $operationClaimSelect = $('#OperationClaimSelect');

            var userClaimsMap = {};
            var currentEditUserId = null;

            function keepScroll(selectEl, st) {
                selectEl.scrollTop = st;
                if (window.requestAnimationFrame) {
                    requestAnimationFrame(function () { selectEl.scrollTop = st; });
                    requestAnimationFrame(function () { selectEl.scrollTop = st; });
                }
                setTimeout(function () { selectEl.scrollTop = st; }, 0);
                setTimeout(function () { selectEl.scrollTop = st; }, 10);
            }

            $operationClaimSelect.on('mousedown', 'option', function (e) {
                e.preventDefault();
                if (this.disabled || this.value === "") return false;

                var select = this.parentElement;
                var st = select.scrollTop;

                this.selected = !this.selected;
                $(select).trigger('change');

                keepScroll(select, st);
                return false;
            });

            $operationClaimSelect.on('click', 'option', function (e) {
                e.preventDefault();
                return false;
            });

            function loadEmployees() {
                return $.get('@Url.Action("GetList", "Employees")', { pageIndex: 0, pageSize: 1000 })
                    .done(function (res) {
                        var list = res.data || res || [];
                        $employeeSelect.empty().append('<option value="">Seçiniz</option>');
                        $.each(list, function (i, e) {
                            if (!e.userId) return;
                            var fullName = [e.firstName, e.lastName].filter(Boolean).join(' ');
                            var text = (e.employeeNumber ? e.employeeNumber + ' - ' : '') + fullName;
                            $employeeSelect.append($('<option/>').val(e.userId).text(text));
                        });
                    })
                    .fail(function (xhr) { handleFail(xhr, 'Personeller alınamadı.'); });
            }

            function loadOperationClaims() {
                return $.get('@Url.Action("GetList", "OperationClaims")', { pageIndex: 0, pageSize: 1000 })
                    .done(function (res) {
                        var list = res.data || res || [];
                        $operationClaimSelect.empty();
                        $operationClaimSelect.append($('<option/>').val('').text('Seçiniz').prop('disabled', true));
                        $.each(list, function (i, c) {
                            $operationClaimSelect.append($('<option/>').val(c.id).text(c.name));
                        });
                    })
                    .fail(function (xhr) { handleFail(xhr, 'Roller alınamadı.'); });
            }

            loadEmployees();
            loadOperationClaims();

            table = $('#userOperationClaimsTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetList", "UserOperationClaims")',
                    type: 'GET',
                    data: function (d) {
                        d.pageIndex = 0;
                        d.pageSize = 100000;
                    },
                    dataSrc: function (json) {
                        var list = json.data || json || [];

                        var map = {};
                        var result = [];

                        $.each(list, function (_, item) {
                            if (!item.userId) return;

                            var key = item.userId;
                            var entry = map[key];

                            if (!entry) {
                                entry = {
                                    userId: item.userId,
                                    employeeId: item.employeeId,
                                    employeeNumber: item.employeeNumber,
                                    employeeFirstName: item.employeeFirstName,
                                    employeeLastName: item.employeeLastName,
                                    claims: []
                                };
                                map[key] = entry;
                                result.push(entry);
                            }

                            if (item.id && item.operationClaimId) {
                                entry.claims.push({ id: item.id, operationClaimId: item.operationClaimId });
                            }
                        });

                        userClaimsMap = map;
                        return result;
                    },
                    error: function (xhr) { handleFail(xhr, 'Liste alınamadı.'); }
                },
                columns: [
                    {
                        data: null,
                        title: '#',
                        width: '70px',
                        className: 'text-center',
                        render: function (data, type, row, meta) { return meta.row + 1; }
                    },
                    {
                        data: null,
                        title: 'Personel',
                        render: function (data, type, row) {
                            var fullName = [row.employeeFirstName, row.employeeLastName].filter(Boolean).join(' ');
                            var text = (row.employeeNumber ? row.employeeNumber + ' - ' : '') + fullName;
                            return text || '-';
                        }
                    },
                    {
                        data: null,
                        title: 'İşlemler',
                        orderable: false,
                        searchable: false,
                        width: '140px',
                        className: 'text-end',
                        render: function (data, type, row) {
                            var disabled = noPermission ? ' disabled aria-disabled="true"' : '';
                            return '' +
                                '<button class="table-action-icon text-warning btn-edit"' + disabled + ' data-user-id="' + row.userId + '" title="Düzenle">' +
                                '<i class="bi bi-pencil-square"></i></button>' +
                                '<button class="table-action-icon text-danger btn-delete"' + disabled + ' data-user-id="' + row.userId + '" title="Tüm Yetkileri Sil">' +
                                '<i class="bi bi-trash"></i></button>';
                        }
                    }
                ],
                paging: true,
                searching: true,
                info: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                drawCallback: function () {
                    if (!noPermission) return;
                    $('body').addClass('no-permission');
                    $('#btnAdd').prop('disabled', true).addClass('disabled');
                }
            });

            function clearValidation() {
                $('#EmployeeSelect,#OperationClaimSelect').removeClass('is-invalid');
                $('#EmployeeSelectError').removeClass('active').text('');
                $('#OperationClaimSelectError').removeClass('active').text('');
            }
            function showEmployeeRequiredError() {
                $('#EmployeeSelect').addClass('is-invalid');
                $('#EmployeeSelectError').addClass('active').text('Personel seçimi zorunludur.');
            }
            function showOperationClaimRequiredError() {
                $('#OperationClaimSelect').addClass('is-invalid');
                $('#OperationClaimSelectError').addClass('active').text('En az bir yetki seçmelisiniz.');
            }

            function openCreateModal() {
                if (noPermission) return;

                currentEditUserId = null;
                $('#userOperationClaimModal').data('mode', 'create');
                $('#UserOperationClaimUserId').val('');
                $('#EmployeeSelect').val('');
                $('#OperationClaimSelect').val([]).trigger('change');
                $employeeSelect.prop('disabled', false);
                clearValidation();
                $('#userOperationClaimModalLabel').text('Yeni Yetki');
                new bootstrap.Modal(document.getElementById('userOperationClaimModal')).show();
            }

            function openEditModal(rowData) {
                if (noPermission) return;

                clearValidation();
                currentEditUserId = rowData.userId;

                $('#userOperationClaimModal').data('mode', 'edit');
                $('#UserOperationClaimUserId').val(rowData.userId);

                $('#EmployeeSelect').val(rowData.userId);
                $employeeSelect.prop('disabled', true);

                var selectedIds = [];
                if (rowData.claims && rowData.claims.length) {
                    $.each(rowData.claims, function (_, c) {
                        if (c.operationClaimId) selectedIds.push(String(c.operationClaimId));
                    });
                }
                $('#OperationClaimSelect').val(selectedIds).trigger('change');

                $('#userOperationClaimModalLabel').text('Yetki Düzenle');
                new bootstrap.Modal(document.getElementById('userOperationClaimModal')).show();
            }

            $('#btnAdd').on('click', function () { openCreateModal(); });

            $('#userOperationClaimsTable').on('click', '.btn-edit', function () {
                if (noPermission) return;
                var row = table.row($(this).closest('tr')).data();
                if (!row || !row.userId) return;
                openEditModal(row);
            });

            var deleteModal = new bootstrap.Modal(document.getElementById('deleteUserOperationClaimModal'));

            $('#userOperationClaimsTable').on('click', '.btn-delete', function () {
                if (noPermission) return;
                var row = table.row($(this).closest('tr')).data();
                if (!row || !row.userId) return;
                $('#DeleteUserId').val(row.userId);
                deleteModal.show();
            });

            $('#btnDeleteConfirm').on('click', function () {
                if (noPermission) return;

                var userId = $('#DeleteUserId').val();
                if (!userId) return;

                postWithToken('@Url.Action("Update", "UserOperationClaims")', {
                    Id: '00000000-0000-0000-0000-000000000000',
                    UserId: userId,
                    OperationClaimIds: [] 
                })
                .done(function () {
                    deleteModal.hide();
                    table.ajax.reload(null, false);
                    showPopup('Yetkiler silindi.', 'success');
                })
                .fail(function (xhr) { handleFail(xhr, 'Silme işlemi sırasında hata oluştu.'); });
            });

            $('#btnSave').on('click', function () {
                if (noPermission) return;

                var userId = $('#EmployeeSelect').val();
                var operationClaimIds = ($('#OperationClaimSelect').val() || []).filter(function (x) { return x && x !== ""; });

                clearValidation();
                var hasError = false;

                if (!userId) { showEmployeeRequiredError(); hasError = true; }
                if (!operationClaimIds.length) { showOperationClaimRequiredError(); hasError = true; }
                if (hasError) return;

                var firstId = '00000000-0000-0000-0000-000000000000';
                var entry = userClaimsMap[userId];
                if (entry && entry.claims && entry.claims.length && entry.claims[0].id) {
                    firstId = entry.claims[0].id;
                }

                postWithToken('@Url.Action("Update", "UserOperationClaims")', {
                    Id: firstId,
                    UserId: userId,
                    OperationClaimIds: operationClaimIds.map(function (x) { return parseInt(x); })
                })
                .done(function () {
                    var modalEl = document.getElementById('userOperationClaimModal');
                    var modal = bootstrap.Modal.getInstance(modalEl);
                    modal.hide();
                    table.ajax.reload(null, false);
                    showPopup('Kaydedildi.', 'success');
                })
                .fail(function (xhr) { handleFail(xhr, 'Kaydetme işlemi sırasında hata oluştu.'); });
            });
        });
    </script>
}
