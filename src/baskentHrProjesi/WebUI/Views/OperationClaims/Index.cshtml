@{
    ViewData["Title"] = "Yetki Tanımları";
    ViewData["Subtitle"] = "Sistem rollerini görüntüleyin ve yönetin.";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <style>
        .table-action-icon {
            border: 0;
            background: transparent;
            padding: 0.15rem 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

            .table-action-icon i {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .table-action-icon + .table-action-icon {
                margin-left: 0.4rem;
            }

            .table-action-icon.text-warning:hover i,
            .table-action-icon.text-danger:hover i {
                opacity: 0.8;
            }

        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        body.no-permission #btnAddOperationClaim {
            pointer-events: none;
            opacity: .55;
        }

        body.no-permission #operationClaimsTable .table-action-icon {
            pointer-events: none;
            opacity: .35;
            cursor: not-allowed;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>Roller</h3>
                <p class="text-subtitle text-muted">@ViewData["Subtitle"]</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Roller</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold d-block mb-1">Roller</span>
            <span class="text-muted small">Sistemde tanımlı rollerin listesini görüntüleyin.</span>
        </div>
        <div>
            <button id="btnAddOperationClaim" class="btn btn-primary btn-sm">
                <i class="bi bi-plus-circle me-1"></i> Yeni Rol
            </button>
        </div>
    </div>
    <div class="card-body">
        <table id="operationClaimsTable" class="table table-striped table-bordered w-100">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Rol Adı</th>
                    <th style="width: 90px;">İşlemler</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="operationClaimModal" tabindex="-1" aria-labelledby="operationClaimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="operationClaimModalLabel">Yeni Rol</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="OperationClaimId" />

                <div class="mb-3">
                    <label for="OperationClaimName" class="form-label">Rol Adı</label>
                    <input type="text"
                           id="OperationClaimName"
                           class="form-control"
                           placeholder="Örn: Admin" />
                    <div id="OperationClaimNameError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">Rol adını benzersiz olacak şekilde giriniz.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-secondary" data-bs-dismiss="modal">
                    Kapat
                </button>
                <button type="button" id="btnSaveOperationClaim" class="btn btn-primary ms-1">
                    Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteOperationClaimModal" tabindex="-1" aria-labelledby="deleteOperationClaimModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteOperationClaimModalLabel">Rol Sil</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                Seçili rolü silmek istediğinize emin misiniz?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light-secondary" data-bs-dismiss="modal">
                    Vazgeç
                </button>
                <button type="button" id="btnDeleteOperationClaimConfirm" class="btn btn-danger ms-1">
                    Sil
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');

                switch ((variant || 'danger').toLowerCase()) {
                    case 'success': toastEl.classList.add('bg-success', 'text-white'); break;
                    case 'warning': toastEl.classList.add('bg-warning', 'text-dark'); break;
                    case 'info': toastEl.classList.add('bg-info', 'text-dark'); break;
                    case 'secondary': toastEl.classList.add('bg-secondary', 'text-white'); break;
                    default: toastEl.classList.add('bg-danger', 'text-white'); break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) {
                    alert(message || '');
                    return;
                }

                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');

                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });

                toast.show();
            }

            function isNoPermission(xhr) {
                var s = (xhr && typeof xhr.status !== 'undefined') ? xhr.status : 0;
                return s === 401 || s === 403 || s === 0 || s >= 500;
            }

            function applyNoPermissionUi() {
                $('#btnAddOperationClaim').prop('disabled', true).addClass('disabled');
                $('body').addClass('no-permission');
                $('#operationClaimsTable').find('.btn-edit,.btn-delete').prop('disabled', true).addClass('disabled');
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;
                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');
                applyNoPermissionUi();
            }

            function handleFail(xhr, msg) {
                if (isNoPermission(xhr)) setNoPermission(msg || 'yetkiniz bulunmamaktadır.');
                else showPopup(msg || 'İşlem sırasında hata oluştu.', 'danger');
            }

            var table = $('#operationClaimsTable').DataTable({
                processing: true,
                serverSide: false,
                searching: true,
                lengthChange: true,
                ajax: {
                    url: '@Url.Action("GetList", "OperationClaims")',
                    type: 'GET',
                    dataSrc: 'data',
                    error: function (xhr) {
                        handleFail(xhr, 'yetkiniz bulunmamaktadır.');
                    }
                },
                columns: [
                    { data: 'id' },
                    { data: 'name' },
                    {
                        data: null,
                        orderable: false,
                        searchable: false,
                        render: function (data, type, row) {
                            return '<button class="table-action-icon text-warning btn-edit" data-id="' + row.id + '">' +
                                '<i class="bi bi-pencil"></i>' +
                                '</button>' +
                                '<button class="table-action-icon text-danger btn-delete" data-id="' + row.id + '">' +
                                '<i class="bi bi-trash"></i>' +
                                '</button>';
                        }
                    }
                ],
                language: { url: 'https://cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json' },
                drawCallback: function () {
                    if (!noPermission) return;
                    applyNoPermissionUi();
                }
            });

            var deleteId = null;

            $('#btnAddOperationClaim').on('click', function () {
                if (noPermission) return;

                $('#OperationClaimId').val('');
                $('#OperationClaimName').val('');
                $('#OperationClaimNameError').removeClass('active').text('');
                $('#operationClaimModalLabel').text('Yeni Rol');
                var modal = new bootstrap.Modal(document.getElementById('operationClaimModal'));
                modal.show();
            });

            $(document).on('click', '.btn-edit', function () {
                if (noPermission) return;

                var id = $(this).data('id');
                $('#OperationClaimNameError').removeClass('active').text('');

                $.get('@Url.Action("Get", "OperationClaims")', { id: id })
                    .done(function (res) {
                        if (!res) {
                            showPopup('Kayıt bulunamadı.', 'warning');
                            return;
                        }

                        $('#OperationClaimId').val(res.id);
                        $('#OperationClaimName').val(res.name);
                        $('#operationClaimModalLabel').text('Rol Düzenle');

                        var modal = new bootstrap.Modal(document.getElementById('operationClaimModal'));
                        modal.show();
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Kayıt getirilemedi.');
                    });
            });

            $('#btnSaveOperationClaim').on('click', function (e) {
                e.preventDefault();
                if (noPermission) return;

                var id = $('#OperationClaimId').val();
                var name = $('#OperationClaimName').val().trim();

                $('#OperationClaimNameError').removeClass('active').text('');

                if (!name) {
                    $('#OperationClaimNameError').addClass('active').text('Rol adı zorunludur.');
                    return;
                }

                var url = id
                    ? '@Url.Action("Update", "OperationClaims")'
                    : '@Url.Action("Create", "OperationClaims")';

                var payload = { Id: id ? parseInt(id) : 0, Name: name };

                $.ajax({
                    url: url,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(payload)
                })
                    .done(function (res) {
                        if (res && res.success) {
                            var modalEl = document.getElementById('operationClaimModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            modal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Kayıt başarıyla kaydedildi.', 'success');
                        } else {
                            showPopup((res && res.message) || 'Kaydetme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Kaydetme işlemi sırasında hata oluştu.');
                    });
            });

            $(document).on('click', '.btn-delete', function () {
                if (noPermission) return;

                deleteId = $(this).data('id');
                var modal = new bootstrap.Modal(document.getElementById('deleteOperationClaimModal'));
                modal.show();
            });

            $('#btnDeleteOperationClaimConfirm').on('click', function (e) {
                e.preventDefault();
                if (noPermission) return;

                if (!deleteId) return;

                $.post('@Url.Action("Delete", "OperationClaims")', { id: deleteId })
                    .done(function (res) {
                        if (res && res.success) {
                            var modalEl = document.getElementById('deleteOperationClaimModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            modal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Silme işlemi tamamlandı.', 'success');
                        } else {
                            showPopup((res && res.message) || 'Silme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Silme işlemi sırasında hata oluştu.');
                    });
            });
        });
    </script>
}
