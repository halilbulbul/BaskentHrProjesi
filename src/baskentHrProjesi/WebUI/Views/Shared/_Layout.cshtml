@{
    var title = ViewData["Title"] as string ?? "Ana Sayfa";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title - İnsan Kaynakları Yönetim Sistemi</title>

    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;400;600;700;800&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="~/css/bootstrap.css" />
    <link rel="stylesheet" href="~/vendors/perfect-scrollbar/perfect-scrollbar.css" />
    <link rel="stylesheet" href="~/vendors/bootstrap-icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/app.css" />
    <link rel="shortcut icon" href="~/images/favicon.svg" type="image/x-icon" />

    @RenderSection("Styles", required: false)
</head>

<body>
    <div id="app">
        <!-- SIDEBAR -->
        <div id="sidebar" class="active">
            <div class="sidebar-wrapper active">
                <div class="sidebar-header">
                    <div class="d-flex justify-content-between">
                        <div class="logo">
                            <a asp-controller="Home" asp-action="Index" class="sidebar-logo-link">
                                <img src="~/images/logo/logo.png" alt="Başkent Üniversitesi" />
                            </a>
                        </div>
                        <div class="toggler">
                            <a href="#" class="sidebar-hide d-xl-none d-block">
                                <i class="bi bi-x bi-middle"></i>
                            </a>
                        </div>
                    </div>
                </div>

                <div class="sidebar-menu">
                    <ul class="menu">
                        <li class="sidebar-title">Menü</li>

                        <li class="sidebar-item">
                            <a asp-controller="Home" asp-action="Index" class="sidebar-link">
                                <i class="bi bi-grid-fill"></i>
                                <span>Anasayfa</span>
                            </a>
                        </li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-diagram-3-fill"></i>
                                <span>Organizasyon</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a asp-controller="Departments" asp-action="Index">Departmanlar</a>
                                </li>
                                <li class="submenu-item">
                                    <a asp-controller="Positions" asp-action="Index">Pozisyonlar</a>
                                </li>
                                <li class="submenu-item">
                                    <a asp-controller="Employees" asp-action="Index">Personeller</a>
                                </li>
                            </ul>
                        </li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-calendar2-week"></i>
                                <span>Çalışma Planı</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a asp-controller="Shifts" asp-action="Index">Mesailer</a>
                                </li>
                            </ul>
                        </li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-card-checklist"></i>
                                <span>Puantaj</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a asp-controller="TimeEntries" asp-action="Index">Personel Giriş/Çıkış</a>
                                </li>
                                <li class="submenu-item">
                                    <a asp-controller="Timesheets" asp-action="Index">Puantajlar</a>
                                </li>
                            </ul>
                        </li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-clock-history"></i>
                                <span>İzin Yönetimi</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a asp-controller="LeaveTypes" asp-action="Index">İzin Türleri</a>
                                </li>
                                <li class="submenu-item">
                                    <a asp-controller="EmployeeLeaves" asp-action="Index">Personel İzinleri</a>
                                </li>
                                <li class="submenu-item">
                                    <a asp-controller="EmployeeLeaves" asp-action="GetLeaves">İzin Talebi</a>
                                </li>
                            </ul>
                        </li>

                        <li class="sidebar-item has-sub">
                            <a href="#" class="sidebar-link">
                                <i class="bi bi-gear-fill"></i>
                                <span>Sistem Yönetimi</span>
                            </a>
                            <ul class="submenu">
                                <li class="submenu-item">
                                    <a asp-controller="OperationClaims" asp-action="Index">Yetki Tanımları</a>
                                </li>
                                <li class="submenu-item">
                                    <a asp-controller="UserOperationClaims" asp-action="Index">Personel Yetkileri</a>
                                </li>
                            </ul>
                        </li>
                    </ul>
                </div>

                <button class="sidebar-toggler btn x">
                    <i data-feather="x"></i>
                </button>
            </div>
        </div>

        <!-- MAIN -->
        <div id="main">
            <header class="mb-3">
                <div class="d-flex justify-content-between align-items-center">
                    <!-- Sol taraf: burger / boş alan -->
                    <div class="flex-grow-1">
                        <a href="#" class="burger-btn d-block d-xl-none">
                            <i class="bi bi-justify fs-3"></i>
                        </a>
                    </div>

                    <!-- Sağ üst: Çıkış -->
                    <form asp-controller="Login"
                          asp-action="Logout"
                          method="post"
                          class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            <i class="bi bi-box-arrow-right"></i>
                            <span class="d-none d-sm-inline ms-1">Çıkış</span>
                        </button>
                    </form>
                </div>
            </header>

            <div class="page-heading">
                @if (IsSectionDefined("PageHeader"))
                {
                    @RenderSection("PageHeader", required: false)
                }
                else
                {
                    <div class="page-title">
                        <div class="row">
                            <div class="col-12 col-md-6 order-md-1 order-last">
                                <h3>@title</h3>
                                <p class="text-subtitle text-muted">
                                    @ViewData["Subtitle"]
                                </p>
                            </div>
                            <div class="col-12 col-md-6 order-md-2 order-first">
                                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                                    <ol class="breadcrumb">
                                        <li class="breadcrumb-item">
                                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                                        </li>
                                        <li class="breadcrumb-item active" aria-current="page">
                                            @title
                                        </li>
                                    </ol>
                                </nav>
                            </div>
                        </div>
                    </div>
                }

                <section class="section">
                    @RenderBody()
                </section>
            </div>

            <footer>
                <div class="footer clearfix mb-0 text-muted">
                    <div class="float-start">
                        <p>@DateTime.Now.Year &copy; İnsan Kaynakları Yönetim Sistemi</p>
                    </div>
                    <div class="float-end">
                        <p>
                            Geliştiren:
                            <span class="text-primary fw-bold">Halil Bülbül</span>
                        </p>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- ÖNCE jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <!-- Diğer scriptler -->
    <script src="~/vendors/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="~/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/main.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
