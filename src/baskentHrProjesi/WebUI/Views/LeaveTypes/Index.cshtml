@{
    ViewData["Title"] = "İzin Tipleri";
    ViewData["Subtitle"] = "İzin tipi listenizi görüntüleyin ve yönetin.";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <style>
        .table-action-icon {
            border: 0;
            background: transparent;
            padding: 0.15rem 0.25rem;
            cursor: pointer;
            line-height: 1;
        }

            .table-action-icon i {
                font-size: 1.2rem;
                font-weight: 700;
            }

            .table-action-icon + .table-action-icon {
                margin-left: 0.4rem;
            }

            .table-action-icon.text-warning:hover i,
            .table-action-icon.text-danger:hover i {
                opacity: 0.8;
            }

        .field-error {
            display: none;
        }

            .field-error.active {
                display: block;
            }

        body.no-permission #btnAdd {
            pointer-events: none;
            opacity: .55;
        }

        body.no-permission #leaveTypesTable .table-action-icon {
            pointer-events: none;
            opacity: .35;
            cursor: not-allowed;
        }
    </style>
}

@section PageHeader {
    <div class="page-title">
        <div class="row">
            <div class="col-12 col-md-6 order-md-1 order-last">
                <h3>İzin Tipleri</h3>
                <p class="text-subtitle text-muted">Departman listenizi görüntüleyin ve yönetin.</p>
            </div>
            <div class="col-12 col-md-6 order-md-2 order-first">
                <nav aria-label="breadcrumb" class="breadcrumb-header float-start float-lg-end">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item">
                            <a asp-controller="Home" asp-action="Index">Anasayfa</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">İzin Tipleri</li>
                    </ol>
                </nav>
            </div>
        </div>
    </div>
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <div>
            <span class="fw-semibold">@ViewData["Title"]</span>
            <div class="small text-muted">@ViewData["Subtitle"]</div>
        </div>

        <button id="btnAdd"
                type="button"
                class="btn btn-primary btn-sm d-inline-flex align-items-center gap-1 px-3 shadow-sm">
            <i class="bi bi-plus-circle-fill"></i>
            <span>Yeni İzin Tipi</span>
        </button>
    </div>
    <div class="card-body">
        <table id="leaveTypesTable" class="table table-striped table-bordered align-middle w-100">
            <thead>
                <tr>
                    <th style="width:70px;">#</th>
                    <th style="width:140px;">Kod</th>
                    <th>İzin Tipi Adı</th>
                    <th class="text-end" style="width:140px;">İşlemler</th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="leaveTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalTitle">Departman</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="LeaveTypeId" />

                <div class="mb-3">
                    <label for="LeaveTypeCode" class="form-label">İzin Tipi Kodu</label>
                    <input type="text"
                           id="LeaveTypeCode"
                           class="form-control"
                           placeholder="Örn: HR01" />
                    <div id="LeaveTypeCodeError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">İzin tipi kodunu benzersiz olacak şekilde giriniz.</div>
                </div>

                <div class="mb-3">
                    <label for="LeaveTypeName" class="form-label">İzin Tipi Adı</label>
                    <input type="text"
                           id="LeaveTypeName"
                           class="form-control"
                           placeholder="Örn: İnsan Kaynakları" />
                    <div id="LeaveTypeNameError" class="field-error text-danger small mt-1"></div>
                    <div class="form-text">İzin tipi adını eksiksiz ve anlaşılır yazınız.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-primary" id="btnSave">
                    <i class="bi bi-save me-1"></i>Kaydet
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteLeaveTypeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Silme Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    Bu izin tipini silmek istediğinize emin misiniz?
                </p>
                <p class="text-muted small mb-0">Bu işlem geri alınamaz.</p>
                <input type="hidden" id="DeleteLeaveTypeId" />
            </div>
            <div class="modal-footer justify-content-between">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Vazgeç</button>
                <button type="button" class="btn btn-danger btn-sm" id="btnDeleteConfirm">
                    <i class="bi bi-trash me-1"></i>Sil
                </button>
            </div>
        </div>
    </div>
</div>

<div class="toast-container position-fixed top-0 end-0 p-3" style="z-index:1080">
    <div id="appToast" class="toast align-items-center border-0 bg-danger text-white" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body" id="appToastBody"></div>
            <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Kapat"></button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(function () {
            $.fn.dataTable.ext.errMode = 'none';

            var noPermission = false;

            function applyToastVariant(toastEl, variant) {
                toastEl.classList.remove('bg-danger', 'bg-success', 'bg-warning', 'bg-info', 'bg-secondary', 'text-white', 'text-dark');

                switch ((variant || 'danger').toLowerCase()) {
                    case 'success': toastEl.classList.add('bg-success', 'text-white'); break;
                    case 'warning': toastEl.classList.add('bg-warning', 'text-dark'); break;
                    case 'info': toastEl.classList.add('bg-info', 'text-dark'); break;
                    case 'secondary': toastEl.classList.add('bg-secondary', 'text-white'); break;
                    default: toastEl.classList.add('bg-danger', 'text-white'); break;
                }
            }

            function showPopup(message, variant) {
                if (!window.bootstrap || !bootstrap.Toast) {
                    alert(message || '');
                    return;
                }

                var toastEl = document.getElementById('appToast');
                var bodyEl = document.getElementById('appToastBody');

                bodyEl.textContent = message || '';
                applyToastVariant(toastEl, variant);

                var toast = null;
                if (bootstrap.Toast.getInstance) toast = bootstrap.Toast.getInstance(toastEl);
                if (!toast) toast = new bootstrap.Toast(toastEl, { delay: 3500 });

                toast.show();
            }

            function isNoPermission(xhr) {
                var s = (xhr && typeof xhr.status !== 'undefined') ? xhr.status : 0;
                return s === 401 || s === 403 || s === 0 || s >= 500;
            }

            function applyNoPermissionUi() {
                $('#btnAdd').prop('disabled', true).addClass('disabled');
                $('body').addClass('no-permission');
                $('#leaveTypesTable').find('.btn-edit,.btn-delete').prop('disabled', true).addClass('disabled');
            }

            function setNoPermission(msg) {
                if (noPermission) return;
                noPermission = true;
                showPopup(msg || 'yetkiniz bulunmamaktadır.', 'danger');
                applyNoPermissionUi();
            }

            function handleFail(xhr, msg) {
                if (isNoPermission(xhr)) setNoPermission(msg || 'yetkiniz bulunmamaktadır.');
                else showPopup(msg || 'İşlem sırasında hata oluştu.', 'danger');
            }

            var table = $('#leaveTypesTable').DataTable({
                ajax: {
                    url: '@Url.Action("GetList", "LeaveTypes")',
                    type: 'GET',
                    dataSrc: 'data',
                    error: function (xhr) {
                        handleFail(xhr, 'yetkiniz bulunmamaktadır.');
                    }
                },
                columns: [
                    {
                        data: null,
                        title: '#',
                        width: '70px',
                        className: 'text-center',
                        render: function (data, type, row, meta) {
                            return meta.row + 1;
                        }
                    },
                    { data: 'code', title: 'Kod', width: '140px' },
                    { data: 'name', title: 'İzin Tipi Adı' },
                    {
                        data: null,
                        title: 'İşlemler',
                        orderable: false,
                        searchable: false,
                        width: '140px',
                        className: 'text-end',
                        render: function (data, type, row) {
                            return `
                                <button class="table-action-icon text-warning btn-edit" data-id="${row.id}" title="Düzenle">
                                    <i class="bi bi-pencil-square"></i>
                                </button>
                                <button class="table-action-icon text-danger btn-delete" data-id="${row.id}" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>`;
                        }
                    }
                ],
                paging: true,
                searching: true,
                info: true,
                lengthChange: true,
                pageLength: 10,
                lengthMenu: [10, 25, 50, 100],
                language: { url: "//cdn.datatables.net/plug-ins/1.13.6/i18n/tr.json" },
                drawCallback: function () {
                    if (!noPermission) return;
                    applyNoPermissionUi();
                }
            });

            function clearValidation() {
                $('#LeaveTypeCode').removeClass('is-invalid');
                $('#LeaveTypeName').removeClass('is-invalid');
                $('#LeaveTypeCodeError').removeClass('active').text('');
                $('#LeaveTypeNameError').removeClass('active').text('');
            }

            function showCodeRequiredError() {
                $('#LeaveTypeCode').addClass('is-invalid');
                $('#LeaveTypeCodeError').addClass('active').text('İzin tipi kodu zorunludur.');
            }

            function showNameRequiredError() {
                $('#LeaveTypeName').addClass('is-invalid');
                $('#LeaveTypeNameError').addClass('active').text('İzin tipi adı zorunludur.');
            }

            function openCreateModal() {
                if (noPermission) return;
                $('#LeaveTypeId').val('');
                $('#LeaveTypeCode').val('');
                $('#LeaveTypeName').val('');
                clearValidation();
                $('#modalTitle').text('Yeni İzin Tipi');
                var modal = new bootstrap.Modal(document.getElementById('leaveTypeModal'));
                modal.show();
            }

            function openEditModal(id) {
                if (noPermission) return;

                clearValidation();
                $.get('@Url.Action("Get", "LeaveTypes")', { id: id })
                    .done(function (res) {
                        $('#LeaveTypeId').val(res.id);
                        $('#LeaveTypeCode').val(res.code);
                        $('#LeaveTypeName').val(res.name);
                        $('#modalTitle').text('Departman Düzenle');
                        var modal = new bootstrap.Modal(document.getElementById('leaveTypeModal'));
                        modal.show();
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Kayıt okunamadı.');
                    });
            }

            $('#btnAdd').on('click', function () { openCreateModal(); });

            $('#leaveTypesTable').on('click', '.btn-edit', function () {
                openEditModal($(this).data('id'));
            });

            var deleteModalEl = document.getElementById('deleteLeaveTypeModal');
            var deleteModal = new bootstrap.Modal(deleteModalEl);

            $('#leaveTypesTable').on('click', '.btn-delete', function () {
                if (noPermission) return;
                $('#DeleteLeaveTypeId').val($(this).data('id'));
                deleteModal.show();
            });

            $('#btnDeleteConfirm').on('click', function () {
                if (noPermission) return;

                var id = $('#DeleteLeaveTypeId').val();
                if (!id) return;

                $.ajax({
                    url: '@Url.Action("Delete", "LeaveTypes")',
                    type: 'POST',
                    data: { id: id }
                })
                    .done(function (res) {
                        if (res && res.success) {
                            deleteModal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Silme işlemi tamamlandı.', 'success');
                        } else {
                            showPopup((res && res.message) || 'Silme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Silme işlemi sırasında hata oluştu.');
                    });
            });

            $('#btnSave').on('click', function () {
                if (noPermission) return;

                clearValidation();

                var id = $('#LeaveTypeId').val();
                var code = $('#LeaveTypeCode').val().trim();
                var name = $('#LeaveTypeName').val().trim();

                var hasError = false;

                if (!code) { showCodeRequiredError(); hasError = true; }
                if (!name) { showNameRequiredError(); hasError = true; }
                if (hasError) return;

                var isNew = !id;

                var url = isNew
                    ? '@Url.Action("Create", "LeaveTypes")'
                    : '@Url.Action("Update", "LeaveTypes")';

                var payload = isNew
                    ? { Code: code, Name: name }
                    : { Id: parseInt(id), Code: code, Name: name };

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: payload
                })
                    .done(function (res) {
                        if (res && res.success) {
                            var modalEl = document.getElementById('leaveTypeModal');
                            var modal = bootstrap.Modal.getInstance(modalEl);
                            modal.hide();
                            table.ajax.reload(null, false);
                            showPopup('Kayıt başarıyla kaydedildi.', 'success');
                        } else {
                            showPopup((res && res.message) || 'Kaydetme işlemi başarısız.', 'warning');
                        }
                    })
                    .fail(function (xhr) {
                        handleFail(xhr, 'Kaydetme işlemi sırasında hata oluştu.');
                    });
            });
        });
    </script>
}
